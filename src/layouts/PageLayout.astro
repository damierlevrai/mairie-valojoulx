---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  section?: string;
  heroImage?: string;
}

const { title, description, section, heroImage } = Astro.props;

const sectionLabels: Record<string, string> = {
  '/mairie':        'La Mairie',
  '/decouvrir':     'Découvrir et visiter',
  '/vie-economique':'Vie économique',
  '/vie-locale':    'Vie locale',
  '/solidarite':    'Solidarité',
  '/environnement': 'Environnement et sécurité',
  '/commune':       'La Commune',
  '/contact':       'Contact',
  '/actualites':    'Actualités',
};
const sectionLabel = sectionLabels[Astro.url.pathname] || title;
---

<Layout title={title} description={description}>
  <Header />
  <main id="main-content">

    <div class={`page-hero${heroImage ? ' page-hero--with-image' : ''}`}
      style={heroImage ? `background-image: url('${heroImage}')` : ''}>
      <div class="page-hero__overlay"></div>
      <div class="page-hero__content">
        {section && <p class="page-hero__section">{section}</p>}
        <h1 class="page-hero__title">{title}</h1>
      </div>
    </div>

    <nav class="breadcrumb" aria-label="Fil d'ariane">
      <div class="container">
        <ol class="breadcrumb__list" role="list">
          <li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Accueil</a></li>
          <li aria-hidden="true" class="breadcrumb__sep">›</li>
          <li class="breadcrumb__item">
            {title === sectionLabel
              ? <span class="breadcrumb__current" aria-current="page">{sectionLabel}</span>
              : <span class="breadcrumb__link">{sectionLabel}</span>
            }
          </li>
          {title !== sectionLabel && (
            <li aria-hidden="true" class="breadcrumb__sep">›</li>
            <li class="breadcrumb__item"><span class="breadcrumb__current" aria-current="page">{title}</span></li>
          )}
        </ol>
      </div>
    </nav>

    <nav class="breadcrumb-sticky" aria-label="Vous êtes ici" id="breadcrumb-sticky">
      <div class="container breadcrumb-sticky__inner">
        <a href="/">Accueil</a>
        <span aria-hidden="true">›</span>
        <a href={Astro.url.pathname} id="sticky-section">{sectionLabel}</a>
        <span aria-hidden="true" id="sticky-sep" style="display:none">›</span>
        <span id="sticky-sub" aria-current="page"></span>
      </div>
    </nav>

    <slot />

  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    position: relative;
    min-height: 180px;
    background: var(--color-primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .page-hero--with-image {
    min-height: 220px;
    background-size: cover;
    background-position: center;
  }

  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 45, 15, 0.65) 0%,
      rgba(20, 45, 15, 0.80) 100%
    );
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2.5rem 1.5rem;
    color: white;
  }

  .page-hero__section {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .page-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }

  .breadcrumb {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    gap: 0.25rem;
    padding: 0.6rem 0;
    font-size: 0.85rem;
  }

  .breadcrumb__link {
    color: var(--color-primary);
    transition: color 0.15s;
  }

  .breadcrumb__link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .breadcrumb__sep {
    color: var(--color-text-light);
    user-select: none;
    padding: 0 0.1rem;
  }

  .breadcrumb__current {
    color: var(--color-text-light);
  }

  /* ── FIL D'ARIANE STICKY ── */
  .breadcrumb-sticky {
    position: sticky;
    top: 80px;
    z-index: 100;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    display: none;
  }

  .breadcrumb-sticky.visible {
    display: block;
  }

  .breadcrumb-sticky__inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    font-size: 0.82rem;
    color: var(--color-text-light);
  }

  .breadcrumb-sticky__inner a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .breadcrumb-sticky__inner a:hover {
    text-decoration: underline;
  }

  #sticky-sub {
    color: var(--color-text);
    font-weight: 600;
  }
</style>

<script>
  const ancreLabels: Record<string, string> = {
    // Mairie
    'conseil':      'Conseil municipal',
    'commissions':  'Commissions communales',
    'epci':         'Représentations intercommunales',
    'bulletins':    'Bulletins municipaux',
    'demarches':    'Démarches administratives',
    'urbanisme':    'Urbanisme',
    'projets':      'Projets et travaux',
    'ecoles':       'Nos écoles et le SIVOS',
    'ccvh':         'Communauté de Communes',
    // Découvrir
    'patrimoine':   'Histoire & Patrimoine',
    'randonnees':   'Randonnées',
    'nature':       'Nature & Environnement',
    'tourisme':     'Office de Tourisme',
    'gite':         'La Grange de Valojoulx',
    // Vie économique
    'entreprises':  'Entreprises & Artisans',
    'producteurs':  'Producteurs locaux',
    'bienetre':     'Métiers du bien-être',
    'art':          "Métiers d'art",
    'hebergements': 'Hébergements',
    // Vie locale
    'associations': 'Associations',
    'salle':        'Salle des fêtes',
    // Solidarité
    'cias':         'CIAS',
    'transport':    'Transport solidaire',
    'urgences':     "Numéros d'urgence",
    // Environnement
    'eau':          'Eau & Déchets',
    'dechets':      'Déchets',
    'risques':      'Prévention des risques',
    'gestes':       'Les bons gestes',
    'vivre':        'Bien vivre ensemble',
    // Commune
    'geographie':      'Géographie',
    'histoire':        'Histoire',
    'nature-commune':  'Nature & Randonnée',
  };

  // ── Fil d'ariane normal ────────────────────────────────────────────────────

  function updateBreadcrumb() {
    const hash = window.location.hash.replace('#', '');
    if (!hash) return;
    const label = ancreLabels[hash];
    if (!label) return;
    const el = document.querySelector('.breadcrumb [aria-current="page"]') as HTMLElement | null;
    if (!el) return;
    if (!el.dataset.original) el.dataset.original = el.textContent ?? '';
    el.textContent = label;
  }

  function resetBreadcrumb() {
    const el = document.querySelector('.breadcrumb [aria-current="page"]') as HTMLElement | null;
    if (!el || !el.dataset.original) return;
    el.textContent = el.dataset.original;
  }

  updateBreadcrumb();

  window.addEventListener('hashchange', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash && ancreLabels[hash]) updateBreadcrumb();
    else resetBreadcrumb();
  });

  // ── Fil d'ariane sticky ────────────────────────────────────────────────────

  const stickyNav = document.getElementById('breadcrumb-sticky');
  const stickySub = document.getElementById('sticky-sub') as HTMLElement | null;
  const stickySep = document.getElementById('sticky-sep') as HTMLElement | null;

  function showSticky(label: string) {
    if (!stickyNav || !stickySub || !stickySep) return;
    stickySub.textContent = label;
    stickySep.style.display = 'inline';
    stickyNav.classList.add('visible');
  }

  function hideSticky() {
    if (!stickyNav || !stickySub || !stickySep) return;
    stickySub.textContent = '';
    stickySep.style.display = 'none';
    stickyNav.classList.remove('visible');
  }

  function updateStickyBreadcrumb() {
    const hash = window.location.hash.replace('#', '');
    const label = hash ? ancreLabels[hash] : null;
    if (label) showSticky(label);
    else hideSticky();
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const label = ancreLabels[entry.target.id];
        if (label) {
          showSticky(label);
          history.replaceState(null, '', '#' + entry.target.id);
        }
      }
    });
  }, { rootMargin: '-100px 0px -60% 0px', threshold: 0 });

  document.querySelectorAll<HTMLElement>('section[id], div[id]').forEach(el => {
    if (ancreLabels[el.id]) observer.observe(el);
  });

  updateStickyBreadcrumb();

  // Forcer l'affichage si un hash est présent au chargement
  // (l'IntersectionObserver ne se déclenche pas pour les sections déjà visibles)
  if (window.location.hash && stickyNav) {
    const initialHash = window.location.hash.replace('#', '');
    if (ancreLabels[initialHash]) {
      showSticky(ancreLabels[initialHash]);
    }
  }

  window.addEventListener('hashchange', updateStickyBreadcrumb);
</script>
