---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  section?: string;
}

const { title, description, section } = Astro.props;
---

<Layout title={title} description={description}>
  <Header />
  <main id="main-content">

    <div class="page-hero">
      <div class="container">
        <h1 class="page-hero__title">{title}</h1>
        {section && <p class="page-hero__subtitle">{section}</p>}
      </div>
    </div>

    <nav class="breadcrumb" aria-label="Fil d'ariane">
      <div class="container">
        <ol class="breadcrumb__list" role="list">
          <li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Accueil</a></li>
          {section && (
            <li aria-hidden="true" class="breadcrumb__sep">›</li>
            <li class="breadcrumb__item"><span class="breadcrumb__link">{section}</span></li>
          )}
          <li aria-hidden="true" class="breadcrumb__sep">›</li>
          <li class="breadcrumb__item"><span class="breadcrumb__current" aria-current="page">{title}</span></li>
        </ol>
      </div>
    </nav>

    <slot />

  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    background: var(--color-primary-dark);
    min-height: 180px;
    display: flex;
    align-items: center;
  }

  .page-hero .container {
    padding-top: 2rem;
    padding-bottom: 2rem;
    text-align: center;
  }

  .page-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .page-hero__subtitle {
    margin-top: 0.5rem;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .breadcrumb {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    gap: 0.25rem;
    padding: 0.6rem 0;
    font-size: 0.85rem;
  }

  .breadcrumb__link {
    color: var(--color-primary);
    transition: color 0.15s;
  }

  .breadcrumb__link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .breadcrumb__sep {
    color: var(--color-text-light);
    user-select: none;
    padding: 0 0.1rem;
  }

  .breadcrumb__current {
    color: var(--color-text-light);
  }
</style>

<script>
  const ancreLabels: Record<string, string> = {
    // Mairie
    'conseil':      'Conseil municipal',
    'commissions':  'Commissions communales',
    'epci':         'Représentations intercommunales',
    'bulletins':    'Bulletins municipaux',
    'demarches':    'Démarches administratives',
    'urbanisme':    'Urbanisme',
    'projets':      'Projets et travaux',
    'ecoles':       'Nos écoles et le SIVOS',
    'ccvh':         'Communauté de Communes',
    // Découvrir
    'patrimoine':   'Histoire & Patrimoine',
    'randonnees':   'Randonnées',
    'nature':       'Nature & Environnement',
    'tourisme':     'Office de Tourisme',
    'gite':         'La Grange de Valojoulx',
    // Vie économique
    'entreprises':  'Entreprises & Artisans',
    'producteurs':  'Producteurs locaux',
    'bienetre':     'Métiers du bien-être',
    'art':          "Métiers d'art",
    'hebergements': 'Hébergements',
    // Vie locale
    'associations': 'Associations',
    'salle':        'Salle des fêtes',
    // Solidarité
    'cias':         'CIAS',
    'transport':    'Transport solidaire',
    'urgences':     "Numéros d'urgence",
    // Environnement
    'eau':          'Eau & Déchets',
    'dechets':      'Déchets',
    'risques':      'Prévention des risques',
    'gestes':       'Les bons gestes',
    'vivre':        'Bien vivre ensemble',
    // Commune
    'geographie':      'Géographie',
    'histoire':        'Histoire',
    'nature-commune':  'Nature & Randonnée',
  };

  function updateBreadcrumb() {
    const hash = window.location.hash.replace('#', '');
    if (!hash) return;

    const label = ancreLabels[hash];
    if (!label) return;

    const breadcrumbCurrent = document.querySelector('.breadcrumb [aria-current="page"]');
    if (!breadcrumbCurrent) return;

    if (!breadcrumbCurrent.dataset.original) {
      breadcrumbCurrent.dataset.original = breadcrumbCurrent.textContent ?? '';
    }

    breadcrumbCurrent.textContent = label;
  }

  function resetBreadcrumb() {
    const breadcrumbCurrent = document.querySelector('.breadcrumb [aria-current="page"]');
    if (!breadcrumbCurrent || !breadcrumbCurrent.dataset.original) return;
    breadcrumbCurrent.textContent = breadcrumbCurrent.dataset.original;
  }

  updateBreadcrumb();

  window.addEventListener('hashchange', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash && ancreLabels[hash]) {
      updateBreadcrumb();
    } else {
      resetBreadcrumb();
    }
  });
</script>
