---
interface Item {
  label: string;
  value: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title = 'Informations pratiques', items } = Astro.props;
---

<div class="infobox">
  <h2 class="infobox__title">{title}</h2>
  <dl class="infobox__table">
    {items.map(({ label, value }) => (
      <div class="infobox__row">
        <dt class="infobox__label">{label}</dt>
        <dd class="infobox__value">{value}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .infobox {
    background: var(--color-primary-pale);
    border-left: 4px solid var(--color-primary);
    border-radius: 4px;
    padding: 1.5rem 1.75rem;
  }

  .infobox__title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .infobox__table {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .infobox__row {
    display: grid;
    grid-template-columns: minmax(120px, 35%) 1fr;
    gap: 0.5rem 1rem;
    align-items: baseline;
  }

  .infobox__label {
    font-weight: 700;
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .infobox__value {
    color: var(--color-text);
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    .infobox__row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .infobox__value {
      padding-left: 0.5rem;
      color: var(--color-text-light);
    }
  }
</style>
