---
import { getCollection } from 'astro:content';
const toutesActus = await getCollection('actualites');
const dernieres = toutesActus
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<section class="info-band">
  <div class="container">
    <div class="info-band__grid">

      <div class="info-band__left">
        <h2 class="info-band__section-titre">Actualités</h2>
        <div class="info-band__actu-liste">
          {dernieres.map(actu => (
            <a
              href={`/actualites/${actu.id.replace(/\.md$/, '')}`}
              class="info-band__actu-item"
            >
              <span class="info-band__actu-cat">{actu.data.categorie}</span>
              <span class="info-band__actu-titre">{actu.data.title}</span>
              <span class="info-band__actu-date">
                {new Date(actu.data.date).toLocaleDateString('fr-FR', {
                  day: 'numeric', month: 'long', year: 'numeric'
                })}
              </span>
            </a>
          ))}
        </div>
        <a href="/actualites" class="info-band__voir-tout">
          Toutes les actualités →
        </a>
      </div>

      <div class="info-band__right">
        <h2 class="info-band__section-titre">Restez informés !</h2>
        <p class="info-band__pocket-text">
          Les informations et alertes de la commune sont aussi sur
          <strong>Panneau Pocket</strong> — application gratuite sur
          smartphone et tablette.
        </p>
        <a
          href="https://www.panneaupocket.com"
          target="_blank"
          rel="noopener noreferrer"
          class="info-band__btn"
        >
          📱 Télécharger Panneau Pocket
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .info-band {
    background: var(--color-primary-dark);
    color: white;
    padding: 3rem 0;
  }

  .info-band__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .info-band__section-titre {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .info-band__actu-liste {
    display: flex;
    flex-direction: column;
  }

  .info-band__actu-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: white;
    transition: padding-left 0.2s;
  }

  .info-band__actu-item:hover { padding-left: 0.5rem; }

  .info-band__actu-cat {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .info-band__actu-titre {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .info-band__actu-date {
    font-size: 0.75rem;
    opacity: 0.55;
  }

  .info-band__voir-tout {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s;
  }

  .info-band__voir-tout:hover { color: white; }

  .info-band__pocket-text {
    opacity: 0.85;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .info-band__btn {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-text);
    padding: 0.65rem 1.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .info-band__btn:hover { opacity: 0.85; }

  @media (max-width: 768px) {
    .info-band__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
