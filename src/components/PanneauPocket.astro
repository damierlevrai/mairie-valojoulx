---
import { getCollection } from 'astro:content';
const toutesActus = await getCollection('actualites');
const dernieres = toutesActus
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<section class="info-band">
  <div class="container">
    <div class="info-band__grid">

      <div class="info-band__left">
        <h2 class="info-band__section-titre">Actualités</h2>
        <div class="info-band__actu-liste">
          {dernieres.map(actu => (
            <a
              href={`/actualites/${actu.id.replace(/\.md$/, '')}`}
              class="info-band__actu-item"
            >
              <span class="info-band__actu-cat">{actu.data.categorie}</span>
              <span class="info-band__actu-titre">{actu.data.title}</span>
              <span class="info-band__actu-date">
                {new Date(actu.data.date).toLocaleDateString('fr-FR', {
                  day: 'numeric', month: 'long', year: 'numeric'
                })}
              </span>
            </a>
          ))}
        </div>
        <a href="/actualites" class="info-band__voir-tout">
          Toutes les actualités →
        </a>
      </div>

      <div class="info-band__right">
        <h2 class="info-band__section-titre">Restez informés !</h2>
        <img
          src="/images/panneau-pocket-logo.png"
          alt="Panneau Pocket"
          class="info-band__pocket-logo"
          width="160"
          height="50"
        />
        <p class="info-band__pocket-text">
          Les informations et alertes de la commune sont aussi sur
          <strong>Panneau Pocket</strong> — application gratuite sur
          smartphone et tablette.
        </p>
        <div class="info-band__stores">
          <a
            href="https://play.google.com/store/apps/details?id=com.panneaupocket.app"
            target="_blank"
            rel="noopener noreferrer"
            class="info-band__store-btn"
            aria-label="Télécharger sur Google Play"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d="M3.18 23.76c.3.17.64.24.99.2l12.6-12.6-3.57-3.57L3.18 23.76zM.54 1.96C.2 2.4 0 3.02 0 3.8v16.4c0 .78.2 1.4.54 1.84l.1.1 9.2-9.2v-.2L.64 3.56l-.1.1zM20.3 10.37l-2.62-1.5-3.97 3.97 3.97 3.97 2.64-1.5c.75-.43.75-1.51-.02-1.94zM4.17.24l12.6 12.6c-.35.04-.7-.03-1-.2L4.17.24z"/>
            </svg>
            Google Play
          </a>
          <a
            href="https://apps.apple.com/fr/app/panneau-pocket/id1438524779"
            target="_blank"
            rel="noopener noreferrer"
            class="info-band__store-btn"
            aria-label="Télécharger sur l'App Store"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98l-.09.06c-.22.14-2.18 1.27-2.16 3.8.03 3.02 2.65 4.03 2.68 4.04l-.07.28zM13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            App Store
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .info-band {
    background: var(--color-primary-dark);
    color: white;
    padding: 3rem 0;
  }

  .info-band__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .info-band__section-titre {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .info-band__actu-liste {
    display: flex;
    flex-direction: column;
  }

  .info-band__actu-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: white;
    transition: padding-left 0.2s;
  }

  .info-band__actu-item:hover { padding-left: 0.5rem; }

  .info-band__actu-cat {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .info-band__actu-titre {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .info-band__actu-date {
    font-size: 0.75rem;
    opacity: 0.55;
  }

  .info-band__voir-tout {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s;
  }

  .info-band__voir-tout:hover { color: white; }

  .info-band__pocket-logo {
    max-width: 160px;
    height: auto;
    margin-bottom: 1rem;
    filter: brightness(0) invert(1);
  }

  .info-band__pocket-text {
    opacity: 0.85;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .info-band__stores {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .info-band__store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: white;
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.2s;
  }

  .info-band__store-btn:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  @media (max-width: 768px) {
    .info-band__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
