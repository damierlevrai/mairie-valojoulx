---
import { getCollection } from 'astro:content';
const actualites = await getCollection('actualites');
const dernieres = actualites
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<section class="info-band">
  <div class="container">
    <div class="info-band__inner">

      <div class="info-band__pocket">
        <h2 class="info-band__titre">Restez informés !</h2>
        <p class="info-band__intro">
          Les informations et alertes de la commune sont aussi sur
          <strong>Panneau Pocket</strong> — application gratuite sur smartphone et tablette.
        </p>
        <a
          href="https://www.panneaupocket.com"
          target="_blank"
          rel="noopener noreferrer"
          class="info-band__btn"
        >
          Télécharger Panneau Pocket
        </a>
      </div>

      <div class="info-band__actus">
        <h3 class="info-band__actus-titre">Dernières informations</h3>
        <div class="info-band__liste">
          {dernieres.map(actu => (
            <a href={`/actualites/${actu.id.replace(/\.md$/, '')}`} class="info-band__item">
              <span class="info-band__item-cat">{actu.data.categorie}</span>
              <span class="info-band__item-titre">{actu.data.title}</span>
              <span class="info-band__item-date">
                {new Date(actu.data.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
              </span>
            </a>
          ))}
        </div>
        <a href="/actualites" class="info-band__voir-tout">Toutes les actualités →</a>
      </div>

    </div>
  </div>
</section>

<style>
  .info-band {
    background: var(--color-primary-dark);
    color: white;
    padding: 3rem 0;
  }

  .info-band__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .info-band__titre {
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .info-band__intro {
    opacity: 0.85;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .info-band__btn {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-text);
    padding: 0.65rem 1.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .info-band__btn:hover { opacity: 0.85; }

  .info-band__actus-titre {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .info-band__liste {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .info-band__item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: white;
    transition: padding-left 0.2s;
  }

  .info-band__item:hover { padding-left: 0.5rem; }

  .info-band__item-cat {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .info-band__item-titre {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .info-band__item-date {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .info-band__voir-tout {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s;
  }

  .info-band__voir-tout:hover { color: white; }

  @media (max-width: 768px) {
    .info-band__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
