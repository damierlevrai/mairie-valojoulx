// no frontmatter needed
---

<footer class="footer" role="contentinfo">
  <div class="footer__main">
    <div class="container footer__grid">

      <!-- ── Col 1 : Identité ── -->
      <div class="footer__col footer__col--brand">
        <a href="/" class="footer__logo-text" aria-label="Accueil — Mairie de Valojoulx">
          Valojoulx
        </a>
        <p class="footer__subtitle">Commune du Périgord Noir</p>

        <address class="footer__address">
          <p>1 place de la Mairie — 24290 Valojoulx</p>
          <p>
            <a href="tel:+33553507778" class="footer__link">05 53 50 77 78</a>
          </p>
          <p>
            <a href="mailto:contact@mairievalojoulx.fr" class="footer__link">
              contact@mairievalojoulx.fr
            </a>
          </p>
        </address>

        <p class="footer__hours">
          Mardi et Vendredi<br />
          8h–12h / 13h30–17h30
        </p>

        <div class="footer__social">
          <a href="#" class="footer__social-link" aria-label="Facebook" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- ── Col 2 : La Mairie ── -->
      <div class="footer__col">
        <h3 class="footer__heading">La Mairie</h3>
        <ul class="footer__links" role="list">
          <li><a href="/mairie" class="footer__link">Conseil municipal</a></li>
          <li><a href="/mairie#demarches" class="footer__link">Démarches</a></li>
          <li><a href="/mairie#urbanisme" class="footer__link">Urbanisme</a></li>
          <li><a href="/mairie#bulletins" class="footer__link">Bulletins municipaux</a></li>
          <li><a href="/mairie#ecoles" class="footer__link">Nos écoles</a></li>
        </ul>
      </div>

      <!-- ── Col 3 : Découvrir ── -->
      <div class="footer__col">
        <h3 class="footer__heading">Découvrir</h3>
        <ul class="footer__links" role="list">
          <li><a href="/decouvrir#patrimoine" class="footer__link">Histoire &amp; Patrimoine</a></li>
          <li><a href="/decouvrir#randonnees" class="footer__link">Randonnées</a></li>
          <li><a href="/decouvrir#gite" class="footer__link">La Grange de Valojoulx</a></li>
          <li><a href="/vie-economique" class="footer__link">Vie économique</a></li>
          <li><a href="/vie-locale#associations" class="footer__link">Associations</a></li>
          <li><a href="/solidarite" class="footer__link">Solidarité</a></li>
        </ul>
      </div>

      <!-- ── Col 4 : Liens utiles ── -->
      <div class="footer__col">
        <h3 class="footer__heading">Liens utiles</h3>
        <ul class="footer__links" role="list">
          <li>
            <a
              href="https://www.cc-valleedelhomme.fr"
              target="_blank"
              rel="noopener noreferrer"
              class="footer__link footer__link--ext"
            >
              Communauté de Communes ↗
            </a>
          </li>
          <li>
            <a
              href="https://www.lascaux-dordogne.com"
              target="_blank"
              rel="noopener noreferrer"
              class="footer__link footer__link--ext"
            >
              Office de Tourisme ↗
            </a>
          </li>
          <li>
            <a
              href="https://www.service-public.fr"
              target="_blank"
              rel="noopener noreferrer"
              class="footer__link footer__link--ext"
            >
              Service-Public.fr ↗
            </a>
          </li>
          <li>
            <a
              href="https://www.atchoum.eu"
              target="_blank"
              rel="noopener noreferrer"
              class="footer__link footer__link--ext"
            >
              Atchoum ↗
            </a>
          </li>
          <li>
            <a
              href="https://www.sictom-perigordnoir.fr"
              target="_blank"
              rel="noopener noreferrer"
              class="footer__link footer__link--ext"
            >
              SICTOM Périgord Noir ↗
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- ── Barre de bas ── -->
  <div class="footer__bottom">
    <div class="container">
      <p class="footer__bottom-text">
        &copy; {new Date().getFullYear()} Commune de Valojoulx — Tous droits réservés
        <span class="footer__sep" aria-hidden="true">·</span>
        <a href="/mentions-legales" class="footer__bottom-link">Mentions légales</a>
        <span class="footer__sep" aria-hidden="true">·</span>
        <a href="/plan-du-site" class="footer__bottom-link">Plan du site</a>
        <span class="footer__sep" aria-hidden="true">·</span>
        <a href="/accessibilite" class="footer__bottom-link">Accessibilité</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary-dark);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
  }

  /* ── GRILLE PRINCIPALE ── */
  .footer__main {
    padding: 4rem 0 3rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 3rem 2.5rem;
    align-items: start;
  }

  /* ── COLONNE 1 : IDENTITÉ ── */
  .footer__logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    display: block;
    line-height: 1.2;
    margin-bottom: 0.3rem;
  }

  .footer__subtitle {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .footer__address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0.75rem;
  }

  .footer__hours {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* ── RÉSEAUX SOCIAUX ── */
  .footer__social {
    display: flex;
    gap: 0.5rem;
  }

  .footer__social-link {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.75);
    transition: background 0.2s, color 0.2s;
  }

  .footer__social-link:hover {
    background: var(--color-accent);
    color: #ffffff;
  }

  /* ── TITRES COLONNES ── */
  .footer__heading {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    font-variant: small-caps;
  }

  /* ── LIENS ── */
  .footer__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer__link {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.875rem;
    transition: color 0.2s;
    display: inline-block;
  }

  .footer__link:hover {
    color: #ffffff;
  }

  /* ── BARRE DE BAS ── */
  .footer__bottom {
    padding: 1rem 0;
    background: rgba(0, 0, 0, 0.2);
  }

  .footer__bottom-text {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
    line-height: 2;
  }

  .footer__bottom-link {
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.2s;
  }

  .footer__bottom-link:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  .footer__sep {
    padding: 0 0.4rem;
    color: rgba(255, 255, 255, 0.2);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 960px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 2rem;
    }

    .footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 540px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .footer__col {
      padding: 1.5rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .footer__col--brand {
      border-top: none;
      padding-top: 0;
    }
  }
</style>
