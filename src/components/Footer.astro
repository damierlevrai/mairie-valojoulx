---
// no frontmatter needed
---

<footer class="footer" role="contentinfo">
  <div class="footer__main">
    <div class="container footer__grid">

      <!-- ── Col 1 : Identité ── -->
      <div class="footer__col footer__col--brand">
        <a href="/" class="footer__logo-text" aria-label="Accueil — Mairie de Valojoulx">
          Valojoulx
        </a>
        <p class="footer__subtitle">Commune du Périgord Noir</p>

        <address class="footer__address">
          <p>1 place de la Mairie — 24290 Valojoulx</p>
          <p><a href="tel:+33553507778" class="footer__link">05 53 50 77 78</a></p>
          <p><a href="mailto:contact@mairievalojoulx.fr" class="footer__link">contact@mairievalojoulx.fr</a></p>
        </address>

        <p class="footer__hours">
          Mardi et Vendredi<br />
          8h–12h / 13h30–17h30
        </p>

        <div class="footer__social">
          <a href="#" class="footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="#" class="footer__social-link" aria-label="YouTube" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- ── Col 2 : La Mairie ── -->
      <div class="footer__col">
        <h3 class="footer__heading">La Mairie</h3>
        <ul class="footer__links" role="list">
          <li><a href="/mairie" class="footer__link">Conseil municipal</a></li>
          <li><a href="/mairie#demarches" class="footer__link">Démarches</a></li>
          <li><a href="/mairie#urbanisme" class="footer__link">Urbanisme</a></li>
          <li><a href="/mairie#bulletins" class="footer__link">Bulletins municipaux</a></li>
          <li><a href="/mairie#ecoles" class="footer__link">Nos écoles</a></li>
        </ul>
      </div>

      <!-- ── Col 3 : Découvrir ── -->
      <div class="footer__col">
        <h3 class="footer__heading">Découvrir</h3>
        <ul class="footer__links" role="list">
          <li><a href="/decouvrir#patrimoine" class="footer__link">Histoire &amp; Patrimoine</a></li>
          <li><a href="/decouvrir#randonnees" class="footer__link">Randonnées</a></li>
          <li><a href="/decouvrir#gite" class="footer__link">La Grange de Valojoulx</a></li>
          <li><a href="/vie-economique" class="footer__link">Vie économique</a></li>
          <li><a href="/vie-locale#associations" class="footer__link">Associations</a></li>
          <li><a href="/solidarite" class="footer__link">Solidarité</a></li>
        </ul>
      </div>

    </div>
  </div>

  <!-- ── Barre de bas ── -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <span>&copy; {new Date().getFullYear()} Commune de Valojoulx — Tous droits réservés</span>
      <div class="footer__bottom-links">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/plan-du-site">Plan du site</a>
        <a href="/mentions-legales#accessibilite">Accessibilité</a>
        <a href="https://www.cc-valleedelhomme.fr" target="_blank" rel="noopener">CCVH ↗</a>
        <a href="https://www.lascaux-dordogne.com" target="_blank" rel="noopener">Office de Tourisme ↗</a>
        <a href="https://www.service-public.fr" target="_blank" rel="noopener">Service-Public.fr ↗</a>
        <a href="https://www.atchoum.eu" target="_blank" rel="noopener">Atchoum ↗</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary-dark);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
  }

  /* ── GRILLE ── */
  .footer__main {
    padding: 4rem 0 0;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 3rem 2.5rem;
    align-items: start;
  }

  /* ── COLONNE 1 ── */
  .footer__logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    display: block;
    line-height: 1.2;
    margin-bottom: 0.3rem;
  }

  .footer__subtitle {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .footer__address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0.75rem;
  }

  .footer__hours {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
  }

  /* ── RÉSEAUX SOCIAUX ── */
  .footer__social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.75);
    transition: background 0.2s, color 0.2s;
  }

  .footer__social-link:hover {
    background: var(--color-accent);
    color: var(--color-text);
  }

  /* ── TITRES COLONNES ── */
  .footer__heading {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    font-variant: small-caps;
  }

  /* ── LIENS ── */
  .footer__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer__link {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.875rem;
    transition: color 0.2s;
    display: inline-block;
  }

  .footer__link:hover {
    color: #ffffff;
  }

  /* ── BARRE DE BAS ── */
  .footer__bottom {
    margin-top: 3rem;
    padding: 1rem 0;
    background: rgba(0, 0, 0, 0.2);
    font-size: 0.78rem;
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .footer__bottom-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer__bottom a {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__bottom a:hover { color: white; }

  /* ── RESPONSIVE ── */
  @media (max-width: 960px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 2rem;
    }

    .footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 540px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .footer__col {
      padding: 1.5rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .footer__col--brand {
      border-top: none;
      padding-top: 0;
    }

    .footer__bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
