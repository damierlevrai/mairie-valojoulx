---
import { getCollection } from 'astro:content';

const allActus = await getCollection('actualites');

const actus = allActus
  .sort((a, b) => {
    if (a.data.epingle && !b.data.epingle) return -1;
    if (!a.data.epingle && b.data.epingle) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3);

function formatDateFr(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  const day = date.getDate();
  const ordinal = day === 1 ? 'er' : '';
  const months = ['janvier','février','mars','avril','mai','juin','juillet',
                  'août','septembre','octobre','novembre','décembre'];
  return `${day}${ordinal} ${months[date.getMonth()]} ${date.getFullYear()}`;
}
---

{actus.length > 0 && (
  <section class="actus-recentes" aria-labelledby="actus-titre">
    <div class="container">

      <div class="actus-recentes__header">
        <div class="actus-recentes__titre-wrap">
          <h2 class="actus-recentes__titre" id="actus-titre">Actualités</h2>
        </div>
        <a href="/actualites" class="actus-recentes__voir-tout">
          Toutes les actualités →
        </a>
      </div>

      <ul class="actus-recentes__grid" role="list">
        {actus.map(actu => (
          <li class={`actu-mini${actu.data.epingle ? ' actu-mini--epinglee' : ''}`}>
            <div class="actu-mini__media">
              {actu.data.image ? (
                <img
                  src={actu.data.image}
                  alt={actu.data.title}
                  class="actu-mini__img"
                  loading="lazy"
                />
              ) : (
                <div class="actu-mini__placeholder" aria-hidden="true">📰</div>
              )}
            </div>
            <div class="actu-mini__body">
              <div class="actu-mini__meta">
                <span class="badge-cat">{actu.data.categorie}</span>
                <time class="actu-mini__date" datetime={actu.data.date}>
                  {formatDateFr(actu.data.date)}
                </time>
              </div>
              <h3 class="actu-mini__titre">
                <a href={`/actualites/${actu.slug}`} class="actu-mini__lien">
                  {actu.data.title}
                </a>
              </h3>
              {actu.data.resume && (
                <p class="actu-mini__resume">{actu.data.resume}</p>
              )}
            </div>
          </li>
        ))}
      </ul>

    </div>
  </section>
)}

<style>
  .actus-recentes {
    padding: 4rem 0 5rem;
    background: #ffffff;
    border-top: 1px solid var(--color-border);
  }

  /* ── EN-TÊTE ── */
  .actus-recentes__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .actus-recentes__titre-wrap {
    position: relative;
    padding-left: 1.25rem;
  }

  .actus-recentes__titre-wrap::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--color-primary);
    border-radius: 4px;
  }

  .actus-recentes__titre {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1.2;
  }

  .actus-recentes__voir-tout {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.875rem;
    white-space: nowrap;
    transition: color 0.15s;
    flex-shrink: 0;
  }

  .actus-recentes__voir-tout:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  /* ── GRILLE ── */
  .actus-recentes__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* ── CARTE MINI ── */
  .actu-mini {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .actu-mini:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.09);
    transform: translateY(-2px);
  }

  .actu-mini--epinglee {
    border-left: 4px solid var(--color-accent);
  }

  /* ── MEDIA ── */
  .actu-mini__media {
    height: 150px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .actu-mini__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .actu-mini:hover .actu-mini__img {
    transform: scale(1.05);
  }

  .actu-mini__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-primary-pale);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }

  /* ── CORPS ── */
  .actu-mini__body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }

  .actu-mini__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge-cat {
    display: inline-block;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 20px;
    white-space: nowrap;
  }

  .actu-mini__date {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  .actu-mini__titre {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1.3;
  }

  .actu-mini__lien {
    color: inherit;
    transition: color 0.15s;
  }

  .actu-mini__lien:hover {
    color: var(--color-primary);
  }

  .actu-mini__resume {
    font-size: 0.82rem;
    color: var(--color-text-light);
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 760px) {
    .actus-recentes__grid {
      grid-template-columns: 1fr;
    }

    .actus-recentes__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
