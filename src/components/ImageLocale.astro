---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

interface Props {
  src: string;
  alt: string;
  label: string;
  ratio?: string;
  class?: string;
}

const { src, alt, label, ratio = '3/2', class: className } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp}'
);

const imagePath = `/src/assets/images/${src}`;
const imageImporter = allImages[imagePath];
const imageModule = imageImporter ? await imageImporter() : null;
---

{imageModule ? (
  <Image
    src={imageModule.default}
    alt={alt}
    width={900}
    height={600}
    format="webp"
    quality={80}
    class={className}
    style={`aspect-ratio: ${ratio}; object-fit: cover; width: 100%; border-radius: 6px;`}
  />
) : (
  <Placeholder label={label} ratio={ratio} />
)}
