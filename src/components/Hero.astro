---
import ImageLocale from './ImageLocale.astro';
---

<section class="hero" aria-label="Bannière d'accueil">
  <div class="hero__bg" aria-hidden="true">
    <ImageLocale
      src="commune/aerienne.jpg"
      alt="Vue aérienne de Valojoulx"
      label="Vue aérienne du village"
      ratio="16/6"
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content container">
    <p class="hero__eyebrow">Commune de la Dordogne</p>
    <h1 class="hero__title">Bienvenue à Valojoulx</h1>
    <p class="hero__subtitle">
      Village authentique au cœur du Périgord Noir
    </p>
    <div class="hero__actions">
      <a href="/decouvrir" class="hero__btn hero__btn--primary">
        Découvrir la commune
      </a>
    </div>

    <div class="hero__raccourcis">
      <a href="/mairie#demarches" class="raccourci">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true">
          <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <span>Démarches</span>
      </a>
      <a href="/vie-economique#hebergements" class="raccourci">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Hébergements</span>
      </a>
      <a href="/solidarite#urgences" class="raccourci">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.22 1.18 2 2 0 012.22 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.16 6.16l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
        </svg>
        <span>Urgences</span>
      </a>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 620px;
    height: 78vh;
    max-height: 780px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* ── IMAGE DE FOND ── */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero__bg :global(img) {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center 40% !important;
    aspect-ratio: unset !important;
    border-radius: 0 !important;
  }

  .hero__bg :global(.placeholder-wrap) {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: unset !important;
    border-radius: 0 !important;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      135deg,
      rgba(42, 74, 37, 0.78) 0%,
      rgba(20, 40, 15, 0.55) 55%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    color: var(--color-white);
    max-width: 680px;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.75);
    border-left: 3px solid var(--color-accent);
    padding-left: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: 300;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 2.75rem;
    max-width: 500px;
  }

  .hero__actions {
    margin-bottom: 2rem;
  }

  .hero__btn--primary {
    display: inline-block;
    padding: 0.8rem 2rem;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    border-radius: 3px;
    background: var(--color-white);
    color: var(--color-primary-dark);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: background 0.25s, color 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  .hero__btn--primary:hover {
    background: var(--color-primary);
    color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(74, 124, 63, 0.4);
  }

  /* Scroll indicator */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0.6;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, transparent, white);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.7); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  /* ── RACCOURCIS ── */
  .hero__raccourcis {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .raccourci {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 8px;
    padding: 0.875rem 1.5rem;
    color: white;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    min-width: 110px;
  }

  .raccourci:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .raccourci span {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 520px;
      height: 85vh;
    }

    .hero__actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .raccourci { min-width: 90px; padding: 0.75rem 1rem; }
  }
</style>
