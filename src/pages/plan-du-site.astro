---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Plan du site"
  section="Plan du site"
  description="Plan du site officiel de la mairie de Valojoulx."
>
  <div class="container" style="padding: 3rem 1.5rem 5rem">
    <div class="plan-grid">

      <div class="plan-section">
        <h2>🏠 Accueil</h2>
        <ul>
          <li><a href="/">Page d'accueil</a></li>
          <li><a href="/actualites">Actualités</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="plan-section">
        <h2>🏛️ La Mairie</h2>
        <ul>
          <li><a href="/mairie">Conseil municipal</a></li>
          <li><a href="/mairie#commissions">Commissions communales</a></li>
          <li><a href="/mairie#epci">Représentations intercommunales</a></li>
          <li><a href="/mairie#bulletins">Bulletins municipaux</a></li>
          <li><a href="/mairie#demarches">Démarches administratives</a></li>
          <li><a href="/mairie#urbanisme">Urbanisme</a></li>
          <li><a href="/mairie#projets">Projets et travaux</a></li>
          <li><a href="/mairie#ecoles">Nos écoles et le SIVOS</a></li>
          <li><a href="/mairie#ccvh">Communauté de Communes</a></li>
        </ul>
      </div>

      <div class="plan-section">
        <h2>🗺️ La Commune</h2>
        <ul>
          <li><a href="/commune">Présentation</a></li>
          <li><a href="/commune#geographie">Géographie</a></li>
          <li><a href="/commune#histoire">Histoire</a></li>
          <li><a href="/commune#patrimoine">Patrimoine</a></li>
          <li><a href="/commune#nature">Nature et randonnée</a></li>
        </ul>
      </div>

      <div class="plan-section">
        <h2>🏰 Découvrir et visiter</h2>
        <ul>
          <li><a href="/decouvrir">Présentation</a></li>
          <li><a href="/decouvrir#patrimoine">Histoire &amp; Patrimoine</a></li>
          <li><a href="/decouvrir#randonnees">Randonnées</a></li>
          <li><a href="/decouvrir#nature">Nature &amp; Environnement</a></li>
          <li><a href="/decouvrir#tourisme">Office de Tourisme</a></li>
          <li><a href="/decouvrir#gite">La Grange de Valojoulx</a></li>
        </ul>
      </div>

      <div class="plan-section">
        <h2>💼 Vie économique</h2>
        <ul>
          <li><a href="/vie-economique">Présentation</a></li>
          <li><a href="/vie-economique#entreprises">Entreprises &amp; Artisans</a></li>
          <li><a href="/vie-economique#producteurs">Producteurs locaux</a></li>
          <li><a href="/vie-economique#bienetre">Métiers du bien-être</a></li>
          <li><a href="/vie-economique#art">Métiers d'art</a></li>
          <li><a href="/vie-economique#hebergements">Hébergements</a></li>
        </ul>
      </div>

      <div class="plan-section">
        <h2>🤝 Vie locale</h2>
        <ul>
          <li><a href="/vie-locale">Présentation</a></li>
          <li><a href="/vie-locale#associations">Associations</a></li>
          <li><a href="/vie-locale#salle">Salle des fêtes</a></li>
        </ul>
      </div>

      <div class="plan-section">
        <h2>❤️ Solidarité</h2>
        <ul>
          <li><a href="/solidarite">Présentation</a></li>
          <li><a href="/solidarite#cias">CIAS</a></li>
          <li><a href="/solidarite#transport">Transport solidaire</a></li>
          <li><a href="/solidarite#urgences">Numéros d'urgence</a></li>
        </ul>
      </div>

      <div class="plan-section">
        <h2>🌿 Environnement</h2>
        <ul>
          <li><a href="/environnement">Présentation</a></li>
          <li><a href="/environnement#eau">Eau &amp; Déchets</a></li>
          <li><a href="/environnement#risques">Prévention des risques</a></li>
          <li><a href="/environnement#gestes">Les bons gestes</a></li>
          <li><a href="/environnement#vivre">Bien vivre ensemble</a></li>
        </ul>
      </div>

      <div class="plan-section">
        <h2>📄 Informations légales</h2>
        <ul>
          <li><a href="/mentions-legales">Mentions légales</a></li>
          <li><a href="/plan-du-site">Plan du site</a></li>
        </ul>
      </div>

    </div>
  </div>
</PageLayout>

<style>
  .plan-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  .plan-section h2 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary-pale);
  }

  .plan-section ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .plan-section ul li::before {
    content: '›';
    color: var(--color-primary);
    margin-right: 0.4rem;
    font-weight: 700;
  }

  .plan-section a {
    color: var(--color-text);
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .plan-section a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .plan-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 540px) {
    .plan-grid { grid-template-columns: 1fr; }
  }
</style>
