---
import PageLayout from '../layouts/PageLayout.astro';
import InfoBox from '../components/InfoBox.astro';
import { mairie } from '../data/mairie.js';

const capaciteItems = [
  { label: 'Repas assis',          value: "Jusqu'à 130 personnes" },
  { label: 'Conférence / réunion', value: "Jusqu'à 200 personnes" },
];

const reservationItems = [
  { label: 'Téléphone', value: mairie.telephone },
  { label: 'Email',     value: mairie.email },
  { label: 'Horaires',  value: mairie.horairesCourt },
  { label: 'Note',      value: 'Réservation par téléphone ou email uniquement' },
];

const equipements = [
  'Grande cuisine fonctionnelle',
  'Tables et chaises en nombre',
  'Vaisselle complète : assiettes diverses, verres, coupes à champagne, couverts, tasses à café, plats, saladiers',
];

const tarifsLignes = [
  { prestation: 'Location journée',        hab: '—', ext: '—' },
  { prestation: 'Location week-end',       hab: '—', ext: '—' },
  { prestation: 'Vaisselle (par couvert)', hab: '—', ext: '—' },
  { prestation: 'Caution',                 hab: '—', ext: '—' },
];

interface Association {
  nom: string;
  activite: string;
  contact?: string;
  contactHref?: string;
  contactLabel?: string;
}

const associations: Association[] = [
  {
    nom: 'UNE BULLE DE BIEN-ÊTRE DORDOGNE',
    activite: "Faire découvrir l'univers du bien-être, du développement personnel, de la parapsychologie, organiser des événements festifs, culturels, écoresponsables et sportifs. Soutien logistique et organisationnel pour les autres associations.",
    contactHref: 'https://une-bulle-de-bien-etre6.webnode.fr',
    contactLabel: 'une-bulle-de-bien-etre6.webnode.fr',
  },
  {
    nom: 'JARDINS ET CABANES',
    activite: "Promouvoir et développer des activités alternatives écologiques, culinaires, créatives, artistiques, sociales et solidaires. Approche agroforestière associant arbres et cultures pour créer un écosystème autonome favorisant la biodiversité et la santé des sols.",
    contactHref: 'mailto:lesjardinsdevalojoulx@gmail.com',
    contactLabel: 'lesjardinsdevalojoulx@gmail.com',
  },
  {
    nom: "ASSOCIATION DE L'ÉGLISE SAINT-LAURENT ET DU PATRIMOINE DE VALOJOULX",
    activite: "Recensement du patrimoine matériel et immatériel de Valojoulx, sauvegarde et réhabilitation.",
    contact: 'Via la mairie',
  },
  {
    nom: 'INITIALES',
    activite: "Promouvoir le théâtre amateur par le biais d'un festival.",
    contact: 'Via la mairie',
  },
  {
    nom: 'ASSOCIATION DES JARDINS DE VALOJOULX',
    activite: "Promouvoir et soutenir l'activité locale, le développement durable et la solidarité.",
    contact: 'Via la mairie',
  },
  {
    nom: 'LES CLEFS DES CHAMPS',
    activite: "Ferme pédagogique. Élevage ovins viande en bio, valorisation de la laine en feutre, location d'ânes bâtés.",
    contactHref: 'mailto:lesclefsdeschamps@gmail.com',
    contactLabel: 'lesclefsdeschamps@gmail.com',
  },
  {
    nom: 'VALOJOULX PÉTANQUE',
    activite: "Jeux et concours de pétanque, animations. Tous les dimanches à partir de 15h (s'il fait beau) à côté de la Salle des Fêtes.",
    contact: 'Via la mairie',
  },
  {
    nom: 'SOCIÉTÉ DE CHASSE LA BRANDE DE VALOJOULX',
    activite: "Développement, protection, repeuplement du gibier, destruction des nuisibles, répression du braconnage.",
    contact: 'Via la mairie',
  },
  {
    nom: 'COMITÉ DES FÊTES DE LA COMMUNE DE VALOJOULX',
    activite: "Animation de la commune par l'organisation de fêtes et manifestations d'ordre culturel, éducatif ou social.",
    contact: 'Via la mairie',
  },
  {
    nom: 'CHORALE DE VALOJOULX',
    activite: "Promouvoir le chant, la musique et les sketches musicaux pratiqués par un nombre variable d'exécutants réunis en chorale.",
    contact: 'Via la mairie',
  },
];
---

<PageLayout
  title="Vie locale et associations"
  section="Vie locale"
  description="Associations, salle des fêtes et vie quotidienne à Valojoulx en Périgord Noir."
>
  <div class="container page-content">

    <p class="chapeau">
      Au cœur de notre territoire rural, le tissu associatif et les équipements communaux sont
      une véritable richesse. Ils créent du lien entre les générations et participent activement
      au dynamisme de notre commune.
    </p>

    <!-- ── 1. ASSOCIATIONS ────────────────────────────── -->
    <section class="section" id="associations" aria-labelledby="asso-titre">
      <div class="section__header">
        <h2 class="section__titre" id="asso-titre">Associations</h2>
      </div>

      <p class="para">
        Grâce à l'engagement précieux de nombreux bénévoles, les associations sont des espaces
        de rencontre, de partage et d'initiatives au service de tous.
      </p>

      <div class="notice-pale">
        <span aria-hidden="true">ℹ️</span>
        <p>En cas d'absence de contact avec une association, s'adresser à la mairie.</p>
      </div>

      <ul class="asso-grid" role="list">
        {associations.map(a => (
          <li class="asso-card">
            <h3 class="asso-card__nom">{a.nom}</h3>
            <p class="asso-card__activite">{a.activite}</p>
            {(a.contact || a.contactHref) && (
              <div class="asso-card__contact">
                {a.contactHref ? (
                  <a
                    href={a.contactHref}
                    target={a.contactHref.startsWith('http') ? '_blank' : undefined}
                    rel={a.contactHref.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="asso-card__link"
                  >
                    {a.contactLabel ?? a.contact}
                  </a>
                ) : (
                  <span class="asso-card__via">{a.contact}</span>
                )}
              </div>
            )}
          </li>
        ))}
      </ul>

      <div class="asso-cta-box">
        <p class="asso-cta-box__text">
          <strong>Vous représentez une association ?</strong> Pour déposer une demande de
          subvention, réserver la salle des fêtes ou figurer sur cette page, contactez la
          mairie aux horaires d'ouverture.
        </p>
        <div class="asso-cta-box__contacts">
          <a href={`tel:${mairie.telephoneLien.slice(4)}`} class="asso-cta-box__tel">
            📞 {mairie.telephone}
          </a>
          <a href={mairie.emailLien} class="asso-cta-box__email">
            ✉️ {mairie.email}
          </a>
        </div>
      </div>
    </section>

    <!-- ── 2. SALLE DES FÊTES ─────────────────────────── -->
    <section class="section" id="salle" aria-labelledby="salle-titre">
      <div class="section__header">
        <h2 class="section__titre" id="salle-titre">La salle des fêtes</h2>
      </div>

      <p class="para">
        La salle des fêtes communale est disponible à la location pour événements privés et
        associatifs : repas de famille, mariages, anniversaires, réunions, conférences.
      </p>

      <div class="salle-cols">
        <!-- Gauche -->
        <div class="salle-col">
          <InfoBox title="Capacité d'accueil" items={capaciteItems} />

          <h3 class="subsection__titre">Équipements</h3>
          <ul class="green-list">
            {equipements.map(e => <li>{e}</li>)}
          </ul>
        </div>

        <!-- Droite -->
        <div class="salle-col">
          <InfoBox title="Réservation" items={reservationItems} />
        </div>
      </div>

      <!-- Tarifs -->
      <div class="tarifs-box">
        <h3 class="tarifs-box__titre">Tarifs de location</h3>
        <div class="table-wrap">
          <table class="tarifs-table" aria-label="Tarifs location salle des fêtes">
            <thead>
              <tr>
                <th scope="col">Prestation</th>
                <th scope="col">Habitants de Valojoulx</th>
                <th scope="col">Extérieurs</th>
              </tr>
            </thead>
            <tbody>
              {tarifsLignes.map((l, i) => (
                <tr class={i % 2 === 0 ? '' : 'row-pale'}>
                  <td class="td-bold">{l.prestation}</td>
                  <td class="td-center td-light">{l.hab}</td>
                  <td class="td-center td-light">{l.ext}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tarifs-note">Tarifs votés en conseil municipal — se renseigner en mairie</p>
        <a href="#" class="btn-outline">Télécharger le règlement de location</a>
      </div>
    </section>

    <!-- ── 3. TIERS-LIEU ──────────────────────────────── -->
    <section class="section" id="tiers-lieu" aria-labelledby="tiers-titre">
      <div class="section__header">
        <h2 class="section__titre" id="tiers-titre">
          Tiers-lieu
          <span class="badge-projet">PROJET DU MANDAT</span>
        </h2>
      </div>

      <div class="projet-encadre">
        <p>
          Le projet de tiers-lieu communal est en cours de développement. Ce futur espace
          convivial et partagé permettra de renforcer les liens entre habitants et d'accueillir
          de nouvelles activités. Plus d'informations à venir.
        </p>
      </div>
    </section>

  </div>
</PageLayout>

<style>
  .page-content {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  /* ── CHAPEAU ── */
  .chapeau {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-light);
    border-left: 4px solid var(--color-accent);
    padding-left: 1.25rem;
    margin-bottom: 3.5rem;
    max-width: 780px;
  }

  /* ── SECTION HEADER ── */
  .section {
    margin-bottom: 4rem;
  }

  .section__header {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .section__header::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: var(--color-primary);
    border-radius: 4px;
  }

  .section__titre {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1.2;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .subsection__titre {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .para {
    line-height: 1.75;
    color: var(--color-text);
    max-width: 780px;
    margin-bottom: 0.75rem;
  }

  /* ── NOTICE PÂLE ── */
  .notice-pale {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    background: var(--color-primary-pale);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 4px;
    padding: 0.8rem 1.1rem;
    margin: 1rem 0 1.5rem;
    max-width: 640px;
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.6;
  }

  /* ── GRILLE ASSOCIATIONS ── */
  .asso-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  /* ── CARTE ASSOCIATION ── */
  .asso-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 6px 6px 0;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .asso-card__nom {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1.35;
  }

  .asso-card__activite {
    font-size: 0.82rem;
    color: var(--color-text);
    line-height: 1.6;
    flex: 1;
  }

  .asso-card__contact {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--color-border);
  }

  .asso-card__link {
    font-size: 0.78rem;
    color: var(--color-primary);
    font-weight: 600;
    word-break: break-all;
    transition: color 0.15s;
  }

  .asso-card__link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .asso-card__via {
    font-size: 0.78rem;
    color: var(--color-text-light);
    font-style: italic;
  }

  /* ── ENCADRÉ CTA ASSOCIATIONS ── */
  .asso-cta-box {
    background: var(--color-primary-pale);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .asso-cta-box__text {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .asso-cta-box__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .asso-cta-box__tel,
  .asso-cta-box__email {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    transition: color 0.15s;
  }

  .asso-cta-box__tel:hover,
  .asso-cta-box__email:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* ── SALLE COLONNES ── */
  .salle-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;
  }

  /* ── LISTE VERTE ── */
  .green-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .green-list li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .green-list li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  /* ── TARIFS ── */
  .tarifs-box {
    background: var(--color-primary-pale);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 6px;
    overflow: hidden;
    max-width: 700px;
  }

  .tarifs-box__titre {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    padding: 1rem 1.25rem 0.75rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .tarifs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    min-width: 360px;
  }

  .tarifs-table thead tr {
    background: var(--color-primary-dark);
  }

  .tarifs-table th {
    padding: 0.6rem 1rem;
    text-align: left;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tarifs-table td {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--color-border);
    line-height: 1.4;
  }

  .tarifs-table tbody tr:last-child td { border-bottom: none; }
  .row-pale { background: #ffffff; }
  .td-bold { font-weight: 600; color: var(--color-text); }
  .td-center { text-align: center; }
  .td-light { color: var(--color-text-light); }

  .tarifs-note {
    padding: 0.6rem 1.25rem;
    font-size: 0.78rem;
    font-style: italic;
    color: var(--color-text-light);
    border-top: 1px solid var(--color-border);
  }

  .btn-outline {
    display: inline-block;
    margin: 0.5rem 1.25rem 1.1rem;
    padding: 0.5rem 1.1rem;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.82rem;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }

  .btn-outline:hover {
    background: var(--color-primary);
    color: #ffffff;
  }

  /* ── BADGE PROJET ── */
  .badge-projet {
    display: inline-block;
    background: #ffffff;
    border: 2px solid var(--color-accent);
    color: #92400e;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.65rem;
    border-radius: 20px;
    text-transform: uppercase;
    font-family: var(--font-body);
    vertical-align: middle;
  }

  /* ── TIERS-LIEU ENCADRÉ ── */
  .projet-encadre {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 2rem;
    text-align: center;
    max-width: 680px;
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-text-light);
    font-style: italic;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 760px) {
    .asso-grid {
      grid-template-columns: 1fr;
    }

    .salle-cols {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
