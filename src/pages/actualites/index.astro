---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const allActus = await getCollection('actualites');

const actus = allActus.sort((a, b) => {
  if (a.data.epingle && !b.data.epingle) return -1;
  if (!a.data.epingle && b.data.epingle) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

function formatDateFr(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  const day = date.getDate();
  const ordinal = day === 1 ? 'er' : '';
  const months = ['janvier','février','mars','avril','mai','juin','juillet',
                  'août','septembre','octobre','novembre','décembre'];
  return `${day}${ordinal} ${months[date.getMonth()]} ${date.getFullYear()}`;
}
---

<PageLayout
  title="Actualités"
  section="Actualités"
  description="Toutes les actualités de la commune de Valojoulx : vie municipale, travaux, culture et informations pratiques."
  heroImage="/images/hero/actualites.jpg"
>
  <div class="container page-content">

    {actus.length === 0 ? (
      <div class="empty-state">
        <span aria-hidden="true">📰</span>
        <p>Aucune actualité publiée pour le moment.</p>
      </div>
    ) : (
      <ul class="actus-grid" role="list">
        {actus.map(actu => (
          <li class={`actu-card${actu.data.epingle ? ' actu-card--epinglee' : ''}`}>
            {actu.data.epingle && (
              <span class="badge-epingle">📌 À la une</span>
            )}

            <div class="actu-card__media">
              {actu.data.image ? (
                <img
                  src={actu.data.image}
                  alt={actu.data.title}
                  class="actu-card__img"
                  loading="lazy"
                />
              ) : (
                <div class="actu-card__placeholder" aria-hidden="true">📰</div>
              )}
            </div>

            <div class="actu-card__body">
              <div class="actu-card__meta">
                <span class="badge-categorie">{actu.data.categorie}</span>
                <time class="actu-card__date" datetime={actu.data.date}>
                  {formatDateFr(actu.data.date)}
                </time>
              </div>

              <h2 class="actu-card__titre">{actu.data.title}</h2>

              {actu.data.resume && (
                <p class="actu-card__resume">{actu.data.resume}</p>
              )}

              <a href={`/actualites/${actu.id.replace(/\.md$/, '')}`} class="actu-card__lien">
                Lire la suite →
              </a>
            </div>
          </li>
        ))}
      </ul>
    )}

  </div>
</PageLayout>

<style>
  .page-content {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  /* ── GRILLE ── */
  .actus-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* ── CARTE ── */
  .actu-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .actu-card:hover {
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .actu-card--epinglee {
    border-left: 4px solid var(--color-accent);
  }

  /* ── BADGE ÉPINGLÉ ── */
  .badge-epingle {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--color-accent);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    z-index: 1;
    white-space: nowrap;
  }

  /* ── MEDIA ── */
  .actu-card__media {
    height: 180px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .actu-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .actu-card:hover .actu-card__img {
    transform: scale(1.04);
  }

  .actu-card__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-primary-pale);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
  }

  /* ── CORPS ── */
  .actu-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .actu-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge-categorie {
    display: inline-block;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 20px;
    white-space: nowrap;
  }

  .actu-card__date {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .actu-card__titre {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1.3;
  }

  .actu-card__resume {
    font-size: 0.875rem;
    color: var(--color-text-light);
    line-height: 1.6;
    flex: 1;
  }

  .actu-card__lien {
    display: inline-block;
    margin-top: 0.25rem;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.875rem;
    transition: color 0.15s;
    align-self: flex-start;
  }

  .actu-card__lien:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  /* ── ÉTAT VIDE ── */
  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-text-light);
  }

  .empty-state span {
    display: block;
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .actus-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .actus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
