---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Page introuvable"
  description="La page que vous cherchez n'existe pas ou a été déplacée."
>
  <div class="not-found">
    <span class="not-found__bg" aria-hidden="true">404</span>
    <h1 class="not-found__titre">Page introuvable</h1>
    <p class="not-found__para">La page que vous cherchez n'existe pas ou a été déplacée.</p>
    <a href="/" class="not-found__btn">Retour à l'accueil</a>
    <nav class="not-found__links" aria-label="Liens rapides">
      <a href="/commune">La Commune</a>
      <span aria-hidden="true">·</span>
      <a href="/mairie">La Mairie</a>
      <span aria-hidden="true">·</span>
      <a href="/contact">Contact</a>
    </nav>
  </div>
</PageLayout>

<style>
  .not-found {
    position: relative;
    text-align: center;
    padding: 4rem 1rem 6rem;
    overflow: hidden;
  }

  .not-found__bg {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 700;
    color: var(--color-primary-pale);
    line-height: 1;
    user-select: none;
    pointer-events: none;
    margin-bottom: -0.5rem;
  }

  .not-found__titre {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .not-found__para {
    font-size: 1rem;
    color: var(--color-text-light);
    line-height: 1.65;
    max-width: 400px;
    margin: 0 auto 2rem;
  }

  .not-found__btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .not-found__btn:hover {
    background: var(--color-primary-dark);
  }

  .not-found__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    font-size: 0.88rem;
  }

  .not-found__links a {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.15s;
  }

  .not-found__links a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .not-found__links span {
    color: var(--color-text-light);
  }
</style>
