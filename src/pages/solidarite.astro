---
import PageLayout from '../layouts/PageLayout.astro';
import InfoBox from '../components/InfoBox.astro';
import { mairie, urgences as urgencesData } from '../data/mairie.js';

const ciasItems = [
  { label: 'Adresse',   value: '1 place des Omnibus, 24290 Montignac-Lascaux' },
  { label: 'Téléphone', value: '05 53 03 09 10' },
  { label: 'Email',     value: 'rs-montignac@cias-vdh.fr' },
];

const i = {
  maison:   `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>`,
  repas:    `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.87c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513m-3-4.87v-1.5m-6 4.5v-1.5m0 1.5c0 1.355.056 2.697.166 4.024C9.51 17.155 10.473 18 11.608 18h.784c1.135 0 2.098-.845 2.192-1.976.11-1.327.166-2.669.166-4.024m-6 0h6"/></svg>`,
  voiture:  `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>`,
  mains:    `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z"/></svg>`,
  hopital:  `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>`,
  document: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/></svg>`,
  coeur:    `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>`,
};

const missionsCias = [
  { svg: i.maison,   titre: 'Aide à la personne',        desc: 'Accompagnement aux actes de la vie quotidienne des personnes âgées et/ou handicapées par du personnel qualifié.' },
  { svg: i.maison,   titre: 'Entretien du cadre de vie', desc: 'Entretien ponctuel ou régulier des pièces de vie principales du logement.' },
  { svg: i.repas,    titre: 'Repas à domicile',          desc: 'Menus préparés et conditionnés sous forme de barquettes, livrés à domicile.' },
  { svg: i.voiture,  titre: 'Transport accompagné',      desc: 'Les aides à domicile peuvent assurer le transport de la personne en perte d\'autonomie (courses, médecin, soins, loisirs).' },
  { svg: i.mains,    titre: 'Aide de l\'aidant',         desc: 'Les proches aidants peuvent bénéficier d\'un relais pour un moment de répit.' },
  { svg: i.hopital,  titre: 'Sortie d\'hospitalisation', desc: 'Aide auprès de votre mutuelle et/ou Prestation de Retour d\'Hospitalisation (ARDH).' },
  { svg: i.document, titre: 'Action sociale',            desc: 'Aide à la constitution de dossiers à caractère social (APA, secours d\'urgence, bons alimentaires…)' },
];

const urgencesImmed = [
  { num: '15',  nom: 'SAMU' },
  { num: '17',  nom: 'Police / Gendarmerie' },
  { num: '18',  nom: 'Pompiers / Secours' },
  { num: '112', nom: 'Urgences européen' },
];

const urgencesSituations = [
  { num: '3919',  nom: 'Violences faites aux femmes',  desc: 'Numéro national d\'écoute et d\'accompagnement, confidentiel et gratuit.' },
  { num: '3677',  nom: 'Maltraitance animale',          desc: 'Pour signaler toute maltraitance. En cas de danger immédiat pour l\'animal : le 17.' },
  { num: '119',   nom: 'Enfance en danger',             desc: 'Pour signaler toute situation mettant un enfant en danger.' },
  { num: '115',   nom: 'Personnes sans abri',           desc: 'Pour les personnes sans abri ou en grande difficulté.' },
];

const urgencesSpecialisees = [
  { num: '0 825 811 811',  nom: 'Centre anti-poison',             desc: 'Pour tout contact avec des substances toxiques (24h/24).' },
  { num: '04 78 87 10 40', nom: 'Centre anti-poison vétérinaire', desc: 'CNITV, pour les animaux exposés à des risques toxiques (24h/24).' },
  { num: '3114',           nom: 'Urgences psychologiques',        desc: 'Écoute et soutien pour toute personne en détresse.' },
  { num: '0 800 23 13 13', nom: 'Drogues, alcool, tabac',         desc: 'Numéro gratuit d\'information et de soutien.' },
  { num: '116 006',        nom: 'Aide aux victimes',              desc: 'Accompagnement pour toute victime de crime ou d\'agression.' },
  { num: '3018',           nom: 'Harcèlement',                    desc: 'Pour signaler harcèlement scolaire, cyberharcèlement ou usurpation d\'identité.' },
];
---

<PageLayout
  title="Solidarité"
  section="Solidarité"
  description="CIAS, transport solidaire Atchoum et numéros d'urgence pour les habitants de Valojoulx."
  heroImage="/images/hero/solidarite.jpg"
>
  <div class="container page-content">

    <p class="chapeau">
      La commune de Valojoulx s'engage aux côtés de ses habitants dans les moments difficiles.
      Cette page regroupe les contacts et ressources utiles en matière de solidarité, d'aide
      sociale et de mobilité.
    </p>

    <!-- ── 1. CIAS ─────────────────────────────────────── -->
    <section class="section" id="cias" aria-labelledby="cias-titre">
      <h2 class="section-titre" id="cias-titre">Le CIAS</h2>

      <p class="para">
        Le Centre Intercommunal d'Action Sociale (CIAS) est un établissement public rattaché à
        la Communauté de communes de la Vallée de l'Homme. Il intervient à l'échelle de
        l'ensemble des communes du territoire pour accompagner les habitants dans les situations
        de fragilité ou de difficulté sociale.
      </p>

      <h3 class="subsection__titre">Ses missions</h3>
      <ul class="missions-grid" role="list">
        {missionsCias.map(m => (
          <li class="mission-card">
            <span class="svg-icon mission-card__icone" set:html={m.svg} aria-hidden="true"></span>
            <div>
              <strong class="mission-card__titre">{m.titre}</strong>
              <p class="mission-card__desc">{m.desc}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="infobox-wrap">
        <InfoBox title="CIAS — Antenne de Montignac-Lascaux" items={ciasItems} />
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ── 2. ATCHOUM ──────────────────────────────────── -->
    <section class="section" id="transport" aria-labelledby="transport-titre">
      <h2 class="section-titre" id="transport-titre">Transport solidaire Atchoum</h2>

      <div class="atchoum-hero">
        <img src="/images/logos/logo-atchoum.png" alt="Atchoum - Transport solidaire" class="logo-partenaire" />
        <p class="atchoum-hero__accroche">ATCHOUM : le transport solidaire près de chez vous</p>
        <p class="atchoum-hero__desc">
          Atchoum met en relation des habitants ayant besoin d'un trajet avec des conducteurs
          volontaires. Un service simple et solidaire pour faciliter les déplacements et renforcer
          l'entraide locale. Vous pouvez aussi devenir conducteur solidaire&nbsp;!
        </p>
      </div>

      <div class="atchoum-cols">
        <!-- Gauche -->
        <div class="atchoum-col">
          <h3 class="subsection__titre">Pour quoi faire ?</h3>
          <ul class="liste-verte" role="list">
            <li>Rendez-vous médicaux</li>
            <li>Courses</li>
            <li>Démarches administratives</li>
            <li>Visites ou événements locaux</li>
          </ul>
          <h3 class="subsection__titre" style="margin-top:1.25rem">Pour qui ?</h3>
          <p class="para" style="margin-bottom:0">
            Service ouvert à tous, notamment : personnes âgées, habitants sans véhicule, personnes
            isolées, jeunes et actifs.
          </p>
        </div>

        <!-- Droite -->
        <div class="atchoum-col">
          <h3 class="subsection__titre">Comment ça marche ?</h3>
          <ol class="steps-list">
            <li>Inscription gratuite sur <a href="https://www.atchoum.eu" target="_blank" rel="noopener noreferrer" class="text-link">www.atchoum.eu</a></li>
            <li>Déposez votre demande ou proposez un trajet</li>
            <li>Mise en relation avec un conducteur volontaire</li>
          </ol>
          <div class="atchoum-num">
            <span class="atchoum-num__label">Numéro d'appel</span>
            <a href="tel:+33806110444" class="atchoum-num__tel">0 806 110 444</a>
          </div>
        </div>
      </div>

      <div class="atchoum-solutions">
        <span class="badge-solution">Covoiturage — trajets partagés</span>
        <span class="badge-solution">Transport solidaire — porte à porte</span>
      </div>

      <div class="atchoum-tarifs">
        <h3 class="subsection__titre">Tarifs</h3>
        <p class="para">
          Le trajet est payant pour le passager afin d'indemniser le conducteur. La Communauté
          de Communes de la Vallée de l'Homme peut prendre en charge <strong>50% du coût du
          trajet</strong> (sans condition de ressources) avec les tickets mobilité.
          Paiement par carte bancaire ou tickets mobilité.
        </p>
      </div>

      <a
        href="https://www.atchoum.eu"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        Accéder à Atchoum ↗
      </a>
    </section>

    <hr class="section-divider" />

    <!-- ── 3. URGENCES ─────────────────────────────────── -->
    <section class="section" id="urgences" aria-labelledby="urgences-titre">
      <h2 class="section-titre" id="urgences-titre">Numéros d'urgence</h2>

      <p class="para">
        La sécurité et le bien-être des personnes sont une priorité pour notre commune.
        N'hésitez pas à utiliser ces numéros : chaque appel peut sauver une vie.
      </p>

      <!-- Urgences immédiates -->
      <h3 class="subsection__titre">Numéros d'urgence immédiats</h3>
      <ul class="urgences-immed" role="list">
        {urgencesImmed.map(u => (
          <li>
            <div class="urgence-card">
              <div class="urgence-card__numero">{u.num}</div>
              <div class="urgence-card__label">{u.nom}</div>
            </div>
          </li>
        ))}
      </ul>

      <!-- Situations particulières -->
      <h3 class="subsection__titre">Situations particulières</h3>
      <ul class="urgences-situations" role="list">
        {urgencesSituations.map(u => (
          <li class="urgence-situ">
            <strong class="urgence-situ__num">{u.num}</strong>
            <div>
              <p class="urgence-situ__nom">{u.nom}</p>
              <p class="urgence-situ__desc">{u.desc}</p>
            </div>
          </li>
        ))}
      </ul>

      <!-- Numéros spécialisés -->
      <h3 class="subsection__titre">Numéros spécialisés</h3>
      <ul class="urgences-spec" role="list">
        {urgencesSpecialisees.map(u => (
          <li class="urgence-spec">
            <strong class="urgence-spec__num">{u.num}</strong>
            <p class="urgence-spec__nom">{u.nom}</p>
            <p class="urgence-spec__desc">{u.desc}</p>
          </li>
        ))}
      </ul>

      <!-- Défibrillateur -->
      <div class="encadre-warning">
        <p class="defib-box__titre"><span class="svg-icon" set:html={i.coeur} aria-hidden="true" style="display:inline-flex;vertical-align:middle;margin-right:0.35rem"></span>Défibrillateur</p>
        <p class="defib-box__text">
          Information à venir : emplacement du défibrillateur communal. Pour tout
          renseignement, contactez la mairie au
          <a href="tel:+33553507778" class="defib-box__tel">05 53 50 77 78</a>.
        </p>
      </div>
    </section>

  </div>
</PageLayout>

<style>
  .page-content {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  /* ── CHAPEAU ── */
  .chapeau {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-light);
    border-left: 4px solid var(--color-accent);
    padding-left: 1.25rem;
    margin-bottom: 3.5rem;
    max-width: 780px;
  }

  /* ── SECTION ── */
  .section {
    margin-bottom: 4rem;
  }

  .subsection__titre {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .para {
    line-height: 1.75;
    color: var(--color-text);
    max-width: 780px;
  }

  .infobox-wrap {
    margin-top: 1.75rem;
    max-width: 560px;
  }

  /* ── MISSIONS CIAS ── */
  .missions-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  .mission-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.1rem 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .mission-card__icone {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color-primary);
  }

  .mission-card__titre {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 0.2rem;
  }

  .mission-card__desc {
    font-size: 0.82rem;
    color: var(--color-text-light);
    line-height: 1.55;
  }

  /* ── ATCHOUM HERO ── */
  .atchoum-hero {
    background: var(--color-primary-pale);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 6px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 1.75rem;
    max-width: 820px;
  }

  .atchoum-hero__accroche {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 0.65rem;
  }

  .atchoum-hero__desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  /* ── ATCHOUM COLONNES ── */
  .atchoum-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 1.5rem;
  }

  /* ── ÉTAPES ── */
  .steps-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .steps-list li {
    padding-left: 0.25rem;
  }

  .text-link {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.15s;
  }

  .text-link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  /* ── NUMÉRO ATCHOUM ── */
  .atchoum-num {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .atchoum-num__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
  }

  .atchoum-num__tel {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
    transition: color 0.15s;
    line-height: 1.1;
  }

  .atchoum-num__tel:hover {
    color: var(--color-primary-dark);
  }

  /* ── SOLUTIONS ATCHOUM ── */
  .atchoum-solutions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .badge-solution {
    display: inline-flex;
    align-items: center;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.3rem 0.9rem;
    border-radius: 20px;
  }

  /* ── TARIFS ── */
  .atchoum-tarifs {
    margin-bottom: 1.25rem;
  }

  /* ── URGENCES IMMÉDIATES ── */
  .urgences-immed {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .urgence-card {
    background: var(--color-primary-dark);
    border-radius: 10px;
    padding: 1.5rem;
    text-align: center;
    color: white;
    box-shadow: 0 4px 16px rgba(58,97,48,0.25);
  }

  .urgence-card__numero {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .urgence-card__label {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.85;
  }

  /* ── SITUATIONS PARTICULIÈRES ── */
  .urgences-situations {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .urgence-situ {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.1rem 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .urgence-situ__num {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    flex-shrink: 0;
    min-width: 52px;
    line-height: 1.2;
  }

  .urgence-situ__nom {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .urgence-situ__desc {
    font-size: 0.8rem;
    color: var(--color-text-light);
    line-height: 1.5;
  }

  /* ── NUMÉROS SPÉCIALISÉS ── */
  .urgences-spec {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .urgence-spec {
    background: var(--color-primary-pale);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
