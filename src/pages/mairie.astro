---
import PageLayout from '../layouts/PageLayout.astro';
import InfoBox from '../components/InfoBox.astro';
import { mairie } from '../data/mairie.js';

const coordItems = [
  { label: 'Adresse',   value: `${mairie.adresse}, ${mairie.codePostal} ${mairie.commune}` },
  { label: 'Téléphone', value: mairie.telephone },
  { label: 'Email',     value: mairie.email },
  { label: 'Horaires',  value: 'Mardi 8h–12h et 13h30–17h30 / Vendredi 8h–12h et 13h30–17h30' },
  { label: 'Maire',     value: mairie.maire },
];

const adjoints = mairie.adjoints;
const conseillers = mairie.conseillers;

const commissions = [
  { nom: 'Vivre ensemble — affaires culturelles',                   referent: 'Martine DERENNE',    membres: 'Brigitte DARTENSET, Nicolas DUQUERROY, Catherine BEATRIX' },
  { nom: 'Communication',                                           referent: 'Danielle AVEZ',      membres: 'Jean-François BLAN, Nicolas DUQUERROY' },
  { nom: 'Bâtiment, voirie, espaces verts',                        referent: 'Jean-François BLAN', membres: 'Jean-Pierre MÈGE, Nicolas DUQUERROY, Bruno BASTIAN, Philippe BASTIDE' },
  { nom: 'Urbanisme, cimetières, assainissement',                  referent: 'Jean-Pierre MÈGE',   membres: 'Jean-François BLAN, Philippe BASTIDE, Brigitte DARTENSET' },
  { nom: 'Finances',                                               referent: 'Nicolas DUQUERROY',  membres: 'Martine DERENNE, Jean-François BLAN, Alain LAURENT' },
  { nom: 'Sécurité — Plan de sauvegarde',                          referent: 'Danielle AVEZ',      membres: 'Martine DERENNE, Jean-François BLAN, Nicolas DUQUERROY, Catherine BEATRIX' },
  { nom: 'Scolaire et jeunesse',                                   referent: 'Alain LAURENT',      membres: 'Martine DERENNE, Nicolas DUQUERROY, Catherine BEATRIX' },
  { nom: 'Environnement, développement durable, bien-être animal', referent: 'Nicolas DUQUERROY',  membres: 'Brigitte DARTENSET, Jean-François BLAN, Catherine BEATRIX' },
  { nom: 'Vie associative',                                        referent: 'Martine DERENNE',    membres: 'Philippe BASTIDE, Brigitte DARTENSET, Catherine BEATRIX' },
];

const intercoms = [
  { structure: 'SMAEP des 2 rivières',    competence: 'Eau potable',               titulaires: 'Jean-Pierre MÈGE, Nicolas DUQUERROY',  suppleants: 'Jean-François BLAN, Brigitte DARTENSET' },
  { structure: 'SICTOM du Périgord Noir', competence: 'Déchets',                   titulaires: 'Philippe BASTIDE, Nicolas DUQUERROY',  suppleants: 'Jean-François BLAN, Mireille CALVO' },
  { structure: 'SDE24',                   competence: 'Énergie, électricité',      titulaires: 'Nicolas DUQUERROY, Bruno BASTIAN',     suppleants: 'Jean-Pierre MÈGE, Catherine BEATRIX' },
  { structure: 'Irrigation de Montignac', competence: 'Irrigation',                titulaires: 'Philippe BASTIDE, Jean-François BLAN', suppleants: 'Martine DERENNE, Danielle AVEZ' },
  { structure: 'SIVS de Montignac',       competence: 'Transport scolaire',        titulaires: 'Martine DERENNE, Alain LAURENT',       suppleants: 'Catherine BEATRIX, Brigitte DARTENSET' },
  { structure: 'SIVOS Vallée Vézère',     competence: 'Affaires scolaires',        titulaires: 'Mireille CALVO, Martine DERENNE',      suppleants: 'Nicolas DUQUERROY, Alain LAURENT' },
  { structure: 'Ministère de la Défense', competence: '—',                         titulaires: 'Bruno BASTIAN',                        suppleants: 'Brigitte DARTENSET' },
  { structure: 'SMBVVD',                  competence: 'Milieux aquatiques Vézère', titulaires: 'Bruno BASTIAN',                        suppleants: 'Jean-Pierre MÈGE' },
];

const bulletins = [
  { num: 61, date: 'Juin 2021' },
  { num: 62, date: 'Décembre 2021' },
  { num: 63, date: 'Juin 2022' },
  { num: 64, date: 'Décembre 2022' },
  { num: 65, date: 'Juin 2023' },
  { num: 66, date: 'Décembre 2023' },
  { num: 67, date: 'Juin 2024' },
  { num: 68, date: 'Décembre 2024' },
  { num: 69, date: 'Juin 2025' },
  { num: 70, date: 'Décembre 2025' },
  { num: 71, date: 'Juin 2026' },
];

const franceServicesItems = [
  { label: 'Adresse',   value: 'Place Yvon Delbos - Mairie, 24290 Montignac-Lascaux' },
  { label: 'Téléphone', value: '05 53 51 79 90' },
  { label: 'Email',     value: 'france-services.montignac@cc-vh.fr' },
];

const demarchesMairie = [
  "Actes d'état civil (naissance, mariage, décès)",
  "Carte nationale d'identité et passeport",
  "Listes électorales",
  "Recensement militaire (obligation à 16 ans)",
  "Autorisation de sortie du territoire pour mineurs",
  "Plan cadastral et PLU",
  "Permis de construire et déclarations préalables",
  "Inscription scolaire",
];

const ccvhMissions = [
  { emoji: '💼', titre: 'Développement économique et touristique', desc: "Soutien aux entreprises, gestion des zones d'activités, promotion du territoire." },
  { emoji: '🌿', titre: 'Environnement',                           desc: 'Gestion des déchets, protection des milieux naturels, transition énergétique.' },
  { emoji: '🏛️', titre: 'Patrimoine et grands sites',              desc: 'Valorisation des sites majeurs et coordination autour des sites UNESCO.' },
  { emoji: '🗺️', titre: 'Aménagement du territoire',               desc: 'Urbanisme, habitat, mobilités, équipements.' },
  { emoji: '👨‍👩‍👧', titre: 'Services à la population',              desc: 'Enfance-jeunesse, action sociale, culture, sport.' },
];
---

<PageLayout
  title="La Mairie"
  section="La Mairie"
  description="Conseil municipal, démarches administratives, urbanisme, écoles et communauté de communes de Valojoulx."
>
  <div class="container page-content">

    <!-- Infos pratiques -->
    <div class="infos-top" id="intro">
      <div class="infos-top__box">
        <InfoBox title="Mairie de Valojoulx" items={coordItems} />
      </div>
      <p class="infos-top__para">
        La mairie vous accueille pour vous accompagner dans vos démarches du quotidien : état
        civil, inscriptions scolaires, urbanisme, élections ou orientation vers les services
        compétents. La permanence est également un espace d'écoute pour poser vos questions,
        signaler une situation ou vous informer sur les projets de la commune.
      </p>
    </div>

    <!-- ── 1. CONSEIL MUNICIPAL ───────────────────────── -->
    <section class="section" id="conseil" aria-labelledby="conseil-titre">
      <div class="section__header">
        <h2 class="section__titre" id="conseil-titre">Le Conseil Municipal</h2>
      </div>

      <!-- Maire -->
      <div class="maire-card">
        <div class="maire-card__inner">
          <span class="badge-maire">Maire</span>
          <p class="maire-card__nom">{mairie.maire}</p>
        </div>
      </div>

      <!-- Adjoints -->
      <h3 class="h3">Les adjoints</h3>
      <ul class="adjoints-list" role="list">
        {adjoints.map(a => (
          <li class="adjoint-card">
            <p class="adjoint-card__nom">{a.nom}</p>
            <p class="adjoint-card__rang">{a.rang}</p>
          </li>
        ))}
      </ul>

      <!-- Conseillers -->
      <h3 class="h3">Les conseillers municipaux</h3>
      <ul class="conseillers-grid" role="list">
        {conseillers.map(c => (
          <li class="conseiller-item">{c}</li>
        ))}
      </ul>

      <p class="pv-note">
        Les Procès-verbaux des séances du Conseil Municipal peuvent être consultés dans les
        bulletins semestriels de la commune.
      </p>
    </section>

    <!-- ── 2. COMMISSIONS COMMUNALES ─────────────────── -->
    <section class="section" id="commissions" aria-labelledby="commissions-titre">
      <div class="section__header">
        <h2 class="section__titre" id="commissions-titre">Commissions communales</h2>
      </div>

      <div class="table-wrap">
        <table class="data-table" aria-label="Commissions communales de Valojoulx">
          <thead>
            <tr>
              <th scope="col">Commission</th>
              <th scope="col">Référent</th>
              <th scope="col">Membres</th>
            </tr>
          </thead>
          <tbody>
            {commissions.map((c, i) => (
              <tr class={i % 2 === 0 ? '' : 'row-pale'}>
                <td class="td-bold">{c.nom}</td>
                <td class="td-nowrap">{c.referent}</td>
                <td>{c.membres}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── 3. REPRÉSENTATIONS INTERCOMMUNALES ─────────── -->
    <section class="section" id="epci" aria-labelledby="epci-titre">
      <div class="section__header">
        <h2 class="section__titre" id="epci-titre">Représentations intercommunales</h2>
      </div>

      <div class="table-wrap">
        <table class="data-table" aria-label="Représentations intercommunales de Valojoulx">
          <thead>
            <tr>
              <th scope="col">Structure</th>
              <th scope="col">Compétence</th>
              <th scope="col">Titulaires</th>
              <th scope="col">Suppléants</th>
            </tr>
          </thead>
          <tbody>
            {intercoms.map((r, i) => (
              <tr class={i % 2 === 0 ? '' : 'row-pale'}>
                <td class="td-bold td-nowrap">{r.structure}</td>
                <td>{r.competence}</td>
                <td>{r.titulaires}</td>
                <td>{r.suppleants}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── 4. BULLETINS MUNICIPAUX ─────────────────────── -->
    <section class="section" id="bulletins" aria-labelledby="bulletins-titre">
      <div class="section__header">
        <h2 class="section__titre" id="bulletins-titre">Bulletins municipaux</h2>
      </div>

      <p class="para">
        Publié deux fois par an, le bulletin municipal est le lien privilégié entre la mairie
        et les habitants. Il vous permet de suivre la vie de la commune à travers les
        procès-verbaux des conseils municipaux, les décisions prises et les projets en cours.
      </p>

      <ul class="bulletins-grid" role="list">
        {bulletins.map(b => (
          <li class="bulletin-card">
            <span class="bulletin-card__icon" aria-hidden="true">📄</span>
            <strong class="bulletin-card__num">Bulletin n°{b.num}</strong>
            <span class="bulletin-card__date">{b.date}</span>
            <a href="#" class="btn-outline">Télécharger</a>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── 5. DÉMARCHES ADMINISTRATIVES ─────────────────── -->
    <section class="section" id="demarches" aria-labelledby="demarches-titre">
      <div class="section__header">
        <h2 class="section__titre" id="demarches-titre">Démarches administratives</h2>
      </div>

      <div class="france-services-box">
        <h3 class="fs-titre">France Services : un accompagnement près de chez vous</h3>
        <img src="/images/logos/logo-france-service.png" alt="France Services" class="logo-partenaire" />
        <p class="fs-desc">
          L'antenne France Services de Montignac-Lascaux vous accompagne gratuitement dans vos
          démarches administratives du quotidien. Des conseillers sont à votre disposition pour
          vous informer, vous orienter et vous aider.
        </p>
        <div class="fs-cols">
          <div>
            <p class="fs-label">Domaines couverts :</p>
            <ul class="green-list">
              <li>Santé, famille et retraite (CAF, CPAM, MSA…)</li>
              <li>Emploi et insertion</li>
              <li>Impôts et finances publiques</li>
              <li>Titres et documents officiels (carte d'identité, carte grise, permis…)</li>
              <li>Utilisation des services en ligne</li>
            </ul>
            <div class="fs-badges">
              <span class="fs-badge">Gratuit</span>
              <span class="fs-badge">Ouvert à tous</span>
              <span class="fs-badge">Confidentiel</span>
            </div>
          </div>
          <div>
            <InfoBox title="France Services Montignac-Lascaux" items={franceServicesItems} />
          </div>
        </div>
      </div>

      <div class="demarches-cols">
        <div>
          <h3 class="h3">Ce qu'on peut faire en mairie</h3>
          <ul class="green-list">
            {demarchesMairie.map(d => <li>{d}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="h3">Faire ses démarches en ligne</h3>
          <p class="para">
            Vous pouvez effectuer vos démarches sur le site officiel de l'administration
            française Service-Public.fr. Formulaires officiels, pièces à fournir, délais et
            démarches en ligne — simple, fiable et accessible 24h/24.
          </p>
          <a
            href="https://www.service-public.fr"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Accéder à Service-Public.fr ↗
          </a>
        </div>
      </div>
    </section>

    <!-- ── 6. URBANISME ──────────────────────────────────── -->
    <section class="section" id="urbanisme" aria-labelledby="urbanisme-titre">
      <div class="section__header">
        <h2 class="section__titre" id="urbanisme-titre">Urbanisme</h2>
      </div>

      <p class="para">
        À Valojoulx, l'urbanisme vise à préserver notre cadre de vie composé de vallons,
        terres agricoles, forêts et patrimoine bâti. Le Plan Local d'Urbanisme intercommunal
        (PLUi), élaboré par la Communauté de communes de la Vallée de l'Homme, fixe les règles
        pour organiser les constructions et l'aménagement du territoire.
      </p>

      <p class="para">Le PLUi permet de réaliser vos projets tout en :</p>
      <ul class="green-list" style="margin-bottom:1.25rem">
        <li>Protégeant les paysages de la vallée</li>
        <li>Préservant les terres agricoles</li>
        <li>Maintenant le caractère architectural local</li>
        <li>Évitant l'urbanisation dispersée</li>
      </ul>

      <div class="conseil-box">
        <span aria-hidden="true">💡</span>
        <p>
          Avant tout projet de construction ou de travaux, il est conseillé de contacter
          la mairie pour connaître les démarches nécessaires.
        </p>
      </div>

      <div class="btns-row">
        <a href="https://www.cc-valleedelhomme.fr" target="_blank" rel="noopener noreferrer" class="btn-outline">
          Site de la CCVH ↗
        </a>
        <a href="https://www.cc-valleedelhomme.fr" target="_blank" rel="noopener noreferrer" class="btn-outline">
          Consulter le PLUi ↗
        </a>
        <a href="/contact" class="btn-outline">Nous contacter</a>
      </div>
    </section>

    <!-- ── 7. PROJETS ET TRAVAUX ──────────────────────── -->
    <section class="section" id="projets" aria-labelledby="projets-titre">
      <div class="section__header">
        <h2 class="section__titre" id="projets-titre">Projets et travaux</h2>
      </div>

      <div class="projet-col">
        <div class="projet-encart" style="border: 2px solid var(--color-primary);">
          <div class="emoji" aria-hidden="true">🚧</div>
          <p class="projet-encart__titre">Projets et travaux en cours</p>
          <p class="projet-encart__text">Les projets et travaux en cours seront publiés prochainement.</p>
        </div>
        <div class="projet-encart" style="border: 1px solid var(--color-border);">
          <div class="emoji" aria-hidden="true">✅</div>
          <p class="projet-encart__titre">Projets et travaux terminés</p>
          <p class="projet-encart__text">La liste des travaux réalisés sera publiée prochainement.</p>
        </div>
      </div>

      <div class="idees-box">
        <p class="idees-box__emoji" aria-hidden="true">💡</p>
        <h3 class="idees-box__titre">Vous avez une idée pour la commune ?</h3>
        <p class="idees-box__desc">
          Amélioration du cadre de vie, projets, initiatives locales… Faites-nous part de vos
          idées, elles comptent !
        </p>
        <a href="/contact" class="btn-primary">Déposer une idée</a>
      </div>
    </section>

    <!-- ── 8. NOS ÉCOLES ET LE SIVOS ──────────────────── -->
    <section class="section" id="ecoles" aria-labelledby="ecoles-titre">
      <div class="section__header">
        <h2 class="section__titre" id="ecoles-titre">Nos écoles et le SIVOS</h2>
      </div>

      <div class="ecoles-cols">
        <div>
          <h3 class="h3">Le SIVOS</h3>
          <p class="para">
            La commune de Valojoulx fait partie du SIVOS de la Vallée de la Vézère, regroupement
            de communes (La Chapelle-Aubareil, Sergeac, Thonac et Valojoulx) créé en 1990.
            Le SIVOS mutualise les moyens pour assurer un service scolaire de qualité en milieu rural.
          </p>
          <p class="para">Il prend en charge :</p>
          <ul class="green-list">
            <li>Fonctionnement des écoles (budget, matériel, fournitures)</li>
            <li>Cantine et accueil périscolaire</li>
            <li>Personnel non-enseignant</li>
            <li>Entretien et sécurité des bâtiments</li>
            <li>Transports scolaires</li>
          </ul>
          <p class="para" style="margin-top:0.75rem">
            Contact : <a href="mailto:sivosvv@orange.fr" class="text-link">sivosvv@orange.fr</a>
          </p>
        </div>
        <div>
          <h3 class="h3">Le Regroupement Pédagogique (RPI)</h3>
          <p class="para">
            Les écoles sont organisées en Regroupement Pédagogique Intercommunal (RPI).
            Les classes sont réparties entre communes selon les niveaux.
          </p>
          <div class="rpi-note">
            <ul>
              <li><strong>Le RPI</strong> organise la répartition des classes</li>
              <li><strong>Le SIVOS</strong> gère les moyens et le fonctionnement</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="ecoles-grid">
        <div class="ecole-card">
          <span class="ecole-icon" aria-hidden="true">🏫</span>
          <div>
            <h4 class="ecole-nom">École de Thonac</h4>
            <ul class="ecole-niveaux">
              <li>Petite, Moyenne et Grande section Maternelle</li>
              <li>CP</li>
            </ul>
          </div>
        </div>
        <div class="ecole-card">
          <span class="ecole-icon" aria-hidden="true">🏫</span>
          <div>
            <h4 class="ecole-nom">École de La Chapelle-Aubareil</h4>
            <ul class="ecole-niveaux">
              <li>CE1-CE2</li>
              <li>CM1-CM2</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 9. COMMUNAUTÉ DE COMMUNES ─────────────────── -->
    <section class="section" id="ccvh" aria-labelledby="ccvh-titre">
      <div class="section__header">
        <h2 class="section__titre" id="ccvh-titre">La Communauté de Communes</h2>
      </div>
      <img src="/images/logos/logo-ccvh.png" alt="Communauté de Communes Vallée de l'Homme" class="logo-partenaire" />

      <p class="para">
        Notre commune appartient à la <strong>Communauté de communes de la Vallée de l'Homme
        (CCVH)</strong>, qui regroupe 26 communes autour d'un projet commun de développement
        du territoire. Située au cœur du Périgord Noir, elle bénéficie d'un patrimoine naturel
        et préhistorique remarquable, notamment dans la Vallée de la Vézère, classée au patrimoine
        mondial de l'UNESCO.
      </p>

      <h3 class="h3">Ses missions principales</h3>
      <ul class="missions-grid" role="list">
        {ccvhMissions.map(m => (
          <li class="mission-card">
            <span class="mission-icon" aria-hidden="true">{m.emoji}</span>
            <div>
              <strong class="mission-titre">{m.titre}</strong>
              <p class="mission-desc">{m.desc}</p>
            </div>
          </li>
        ))}
      </ul>

      <a
        href="https://www.cc-valleedelhomme.fr"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
        style="margin-top:1.5rem;display:inline-block"
      >
        Site de la CCVH ↗
      </a>
    </section>

  </div>
</PageLayout>

<style>
  .page-content {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  /* ── INFOS TOP ── */
  .infos-top {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 3.5rem;
  }

  .infos-top__box {
    min-width: 340px;
  }

  .infos-top__para {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-text-light);
    border-left: 4px solid var(--color-accent);
    padding-left: 1.25rem;
    font-style: italic;
  }

  /* ── SECTIONS ── */
  .section {
    margin-bottom: 4rem;
  }

  .section__header {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .section__header::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: var(--color-primary);
    border-radius: 4px;
  }

  .section__titre {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1.2;
  }

  .h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  /* ── CONSEIL : MAIRE ── */
  .maire-card {
    background: var(--color-primary-pale);
    border: 1px solid var(--color-primary);
    border-radius: 6px;
    padding: 1.5rem 2rem;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .maire-card__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .badge-maire {
    display: inline-block;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.75rem;
    border-radius: 20px;
  }

  .maire-card__nom {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  /* ── ADJOINTS ── */
  .adjoints-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .adjoint-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
