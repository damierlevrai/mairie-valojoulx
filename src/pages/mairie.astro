---
import PageLayout from '../layouts/PageLayout.astro';
import InfoBox from '../components/InfoBox.astro';
import { mairie } from '../data/mairie.js';

const infosItems = [
  { label: 'Adresse',   value: `${mairie.adresse}, ${mairie.codePostal} ${mairie.commune}` },
  { label: 'Téléphone', value: mairie.telephone },
  { label: 'Email',     value: mairie.email },
  { label: 'Horaires',  value: mairie.horairesCourt },
];

const adjoints = mairie.adjoints;
const conseillers = mairie.conseillers;

const commissions = [
  { nom: 'Vivre ensemble — affaires culturelles', referent: 'Martine Derenne',    membres: 'Brigitte Dartenset, Nicolas Duquerroy, Catherine Beatrix' },
  { nom: 'Communication',                         referent: 'Danielle Avez',      membres: 'Jean-François Blan, Nicolas Duquerroy' },
  { nom: 'Bâtiment, voirie, espaces verts',       referent: 'Jean-François Blan', membres: 'Jean-Pierre Mège, Nicolas Duquerroy, Bruno Bastian, Philippe Bastide' },
  { nom: 'Urbanisme, cimetières, assainissement', referent: 'Jean-Pierre Mège',   membres: 'Jean-François Blan, Philippe Bastide, Brigitte Dartenset' },
  { nom: 'Finances',                              referent: 'Nicolas Duquerroy',  membres: 'Martine Derenne, Jean-François Blan, Alain Laurent' },
  { nom: 'Sécurité — plan de sauvegarde',         referent: 'Danielle Avez',      membres: 'Martine Derenne, Jean-François Blan, Nicolas Duquerroy, Catherine Beatrix' },
  { nom: 'Scolaire et jeunesse',                  referent: 'Alain Laurent',      membres: 'Martine Derenne, Nicolas Duquerroy, Catherine Beatrix' },
  { nom: 'Environnement, développement durable, bien-être animal', referent: 'Nicolas Duquerroy', membres: 'Brigitte Dartenset, Jean-François Blan, Catherine Beatrix' },
  { nom: 'Vie associative',                       referent: 'Martine Derenne',    membres: 'Philippe Bastide, Brigitte Dartenset, Catherine Beatrix' },
];

const intercoms = [
  { structure: 'SMAEP des 2 rivières',       competence: 'Eau potable',                  titulaires: 'Jean-Pierre Mège, Nicolas Duquerroy',  suppleants: 'Jean-François Blan, Brigitte Dartenset' },
  { structure: 'SICTOM du Périgord Noir',    competence: 'Déchets',                      titulaires: 'Philippe Bastide, Nicolas Duquerroy',  suppleants: 'Jean-François Blan, Mireille Calvo' },
  { structure: 'SDE24',                      competence: 'Énergie, électricité',          titulaires: 'Nicolas Duquerroy, Bruno Bastian',     suppleants: 'Jean-Pierre Mège, Catherine Beatrix' },
  { structure: 'Irrigation de Montignac',    competence: 'Irrigation',                   titulaires: 'Philippe Bastide, Jean-François Blan', suppleants: 'Martine Derenne, Danielle Avez' },
  { structure: 'SIVS de Montignac',          competence: 'Transport scolaire',           titulaires: 'Martine Derenne, Alain Laurent',       suppleants: 'Catherine Beatrix, Brigitte Dartenset' },
  { structure: 'SIVOM Vallée Vézère',        competence: 'Affaires scolaires',           titulaires: 'Mireille Calvo, Martine Derenne',      suppleants: 'Nicolas Duquerroy, Alain Laurent' },
  { structure: 'Ministère de la Défense',    competence: '—',                            titulaires: 'Bruno Bastian',                        suppleants: 'Brigitte Dartenset' },
  { structure: 'SMBVVD',                     competence: 'Milieux aquatiques Vézère',    titulaires: 'Bruno Bastian',                        suppleants: 'Jean-Pierre Mège' },
];

const demarchesMairie = [
  'Actes d\'état civil (naissance, mariage, décès)',
  'Carte nationale d\'identité et passeport',
  'Listes électorales',
  'Autorisation de sortie du territoire pour mineurs',
  'Recensement militaire',
  'Plan cadastral et PLU',
  'Permis de construire et déclarations de travaux',
];
---

<PageLayout
  title="La Mairie"
  section="La Mairie"
  description="Retrouvez les informations sur la mairie de Valojoulx : élus, conseil municipal, horaires, démarches administratives."
>
  <div class="container page-content">

    <!-- ── 1. INFOS PRATIQUES ─────────────────────────── -->
    <section class="section" aria-labelledby="infos-titre">
      <div class="section__header">
        <h2 class="section__titre" id="infos-titre">Informations pratiques</h2>
      </div>
      <InfoBox title="Mairie de Valojoulx" items={infosItems} />
    </section>

    <!-- ── 2. CONSEIL MUNICIPAL ───────────────────────── -->
    <section class="section" aria-labelledby="conseil-titre">
      <div class="section__header">
        <h2 class="section__titre" id="conseil-titre">Le conseil municipal</h2>
      </div>

      <!-- Maire -->
      <div class="maire-card" aria-label="La Maire">
        <div class="maire-card__inner">
          <span class="badge badge--maire">Maire</span>
          <p class="maire-card__nom">{mairie.maire}</p>
          <p class="maire-card__role">Maire de Valojoulx</p>
        </div>
      </div>

      <!-- Adjoints -->
      <h3 class="subsection__titre">Les adjoints</h3>
      <ul class="adjoints-list" role="list">
        {adjoints.map(a => (
          <li class="adjoint-item">
            <span class="adjoint-item__rang">{a.rang}</span>
            <span class="adjoint-item__nom">{a.nom}</span>
          </li>
        ))}
      </ul>

      <!-- Conseillers -->
      <h3 class="subsection__titre">Les conseillers municipaux</h3>
      <ul class="conseillers-grid" role="list">
        {conseillers.map(c => (
          <li class="conseiller-item">{c}</li>
        ))}
      </ul>
    </section>

    <!-- ── 2b. COMMISSIONS ────────────────────────────── -->
    <section class="section" aria-labelledby="commissions-titre">
      <div class="section__header">
        <h2 class="section__titre" id="commissions-titre">Commissions communales</h2>
      </div>
      <div class="table-wrap">
        <table class="data-table" aria-label="Commissions communales de Valojoulx">
          <thead>
            <tr>
              <th scope="col">Commission</th>
              <th scope="col">Référent</th>
              <th scope="col">Membres</th>
            </tr>
          </thead>
          <tbody>
            {commissions.map((c, i) => (
              <tr class={i % 2 === 0 ? 'row-pale' : ''}>
                <td class="td-bold">{c.nom}</td>
                <td class="td-nowrap">{c.referent}</td>
                <td>{c.membres}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── 2c. INTERCOMMUNALITÉ ÉLUS ──────────────────── -->
    <section class="section" aria-labelledby="intercom-titre">
      <div class="section__header">
        <h2 class="section__titre" id="intercom-titre">Représentations intercommunales</h2>
      </div>
      <div class="table-wrap">
        <table class="data-table" aria-label="Représentations intercommunales">
          <thead>
            <tr>
              <th scope="col">Structure</th>
              <th scope="col">Compétence</th>
              <th scope="col">Titulaires</th>
              <th scope="col">Suppléants</th>
            </tr>
          </thead>
          <tbody>
            {intercoms.map((r, i) => (
              <tr class={i % 2 === 0 ? 'row-pale' : ''}>
                <td class="td-bold td-nowrap">{r.structure}</td>
                <td>{r.competence}</td>
                <td>{r.titulaires}</td>
                <td>{r.suppleants}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── 3. COMPTES-RENDUS ───────────────────────────── -->
    <section class="section" aria-labelledby="cr-titre">
      <div class="section__header">
        <h2 class="section__titre" id="cr-titre">Comptes-rendus du conseil municipal</h2>
      </div>
      <p class="section__para">
        Les procès-verbaux des séances du conseil municipal sont publiés dans les bulletins
        semestriels de la commune.
      </p>
      <div class="notice-box">
        <span class="notice-box__icon" aria-hidden="true">📄</span>
        <p class="notice-box__text">
          Les documents seront disponibles en téléchargement prochainement.
        </p>
      </div>
    </section>

    <!-- ── 4. DÉMARCHES ────────────────────────────────── -->
    <section class="section" aria-labelledby="demarches-titre">
      <div class="section__header">
        <h2 class="section__titre" id="demarches-titre">Démarches administratives</h2>
      </div>

      <div class="demarches-cols">
        <div class="demarches-col">
          <h3 class="subsection__titre">Ce qu'on peut faire en mairie</h3>
          <ul class="green-list" role="list">
            {demarchesMairie.map(d => <li>{d}</li>)}
          </ul>
        </div>

        <div class="demarches-col">
          <h3 class="subsection__titre">Démarches en ligne</h3>
          <p class="section__para" style="margin-top: 0;">
            De nombreuses démarches administratives sont disponibles en ligne sur le portail
            officiel de l'administration française : état civil, documents d'identité,
            élections, et bien plus encore.
          </p>
          <a
            href="https://www.service-public.fr"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Accéder à service-public.fr
            <span aria-hidden="true"> ↗</span>
          </a>
          <p class="mention">
            Le Plan Local d'Urbanisme (PLU) est consultable en mairie aux heures d'ouverture.
          </p>
        </div>
      </div>
    </section>

    <!-- ── 5. INTERCOMMUNALITÉ ────────────────────────── -->
    <section class="section" aria-labelledby="cc-titre">
      <div class="section__header">
        <h2 class="section__titre" id="cc-titre">Intercommunalité</h2>
      </div>
      <p class="section__para">
        Valojoulx est membre de la <strong>Communauté de Communes de la Vallée de l'Homme</strong>,
        structure intercommunale qui regroupe les compétences en matière d'aménagement du
        territoire, de développement économique et de services à la population.
      </p>
      <a href="#" class="inline-link">Site de la Communauté de Communes →</a>
    </section>

  </div>
</PageLayout>

<style>
  .page-content {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  /* ── SECTION HEADER ── */
  .section {
    margin-bottom: 4rem;
  }

  .section__header {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .section__header::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--color-primary);
    border-radius: 4px;
  }

  .section__titre {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1.2;
  }

  .section__para {
    line-height: 1.75;
    color: var(--color-text);
    max-width: 780px;
    margin-top: 1rem;
  }

  .subsection__titre {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 0.75rem;
    margin-top: 1.5rem;
  }

  /* ── MAIRE CARD ── */
  .maire-card {
    background: var(--color-primary-pale);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 6px;
    padding: 1.5rem 2rem;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .maire-card__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .badge--maire {
    display: inline-block;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.7rem;
    border-radius: 20px;
  }

  .maire-card__nom {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .maire-card__role {
    font-size: 0.88rem;
    color: var(--color-text-light);
  }

  /* ── ADJOINTS ── */
  .adjoints-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .adjoint-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    max-width: 420px;
  }

  .adjoint-item__rang {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    min-width: 90px;
  }

  .adjoint-item__nom {
    font-weight: 600;
    color: var(--color-text);
  }

  /* ── CONSEILLERS ── */
  .conseillers-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem;
    max-width: 560px;
  }

  .conseiller-item {
    padding: 0.5rem 0.9rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 0.9rem;
    color: var(--color-text);
    position: relative;
    padding-left: 1.6rem;
  }

  .conseiller-item::before {
    content: '›';
    position: absolute;
    left: 0.6rem;
    color: var(--color-primary);
    font-weight: 700;
  }

  /* ── TABLES ── */
  .table-wrap {
    overflow-x: auto;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    min-width: 560px;
  }

  .data-table thead tr {
    background: var(--color-primary-dark);
  }

  .data-table th {
    padding: 0.75rem 1rem;
    text-align: left;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .data-table td {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    line-height: 1.5;
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .row-pale {
    background: var(--color-primary-pale);
  }

  .td-bold {
    font-weight: 600;
    color: var(--color-text);
  }

  .td-nowrap {
    white-space: nowrap;
  }

  /* ── NOTICE BOX ── */
  .notice-box {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 1.25rem;
    background: var(--color-primary-pale);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
    max-width: 600px;
  }

  .notice-box__icon {
    font-size: 1.6rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .notice-box__text {
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ── DÉMARCHES ── */
  .demarches-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .green-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .green-list li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  .green-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .btn-primary {
    display: inline-block;
    margin-top: 1.25rem;
    padding: 0.7rem 1.5rem;
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
  }

  .mention {
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--color-text-light);
    font-style: italic;
  }

  /* ── LIEN INLINE ── */
  .inline-link {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
    transition: color 0.15s;
  }

  .inline-link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 700px) {
    .demarches-cols {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .conseillers-grid {
      grid-template-columns: 1fr;
      max-width: 100%;
    }

    .adjoints-list .adjoint-item {
      max-width: 100%;
    }
  }
</style>
