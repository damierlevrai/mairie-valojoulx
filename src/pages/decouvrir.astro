---
import PageLayout from '../layouts/PageLayout.astro';
import InfoBox from '../components/InfoBox.astro';
import { gite } from '../data/mairie.js';

const egliseItems = [
  { label: 'Adresse',              value: 'Le Bourg, 24290 Valojoulx' },
  { label: 'Extérieur',            value: 'Accessible en permanence' },
  { label: 'Intérieur',            value: 'Se renseigner en mairie' },
  { label: 'Journées du Patrimoine', value: 'Ouverture exceptionnelle en septembre' },
  { label: 'Protection',           value: 'Inscrite MH (1974)' },
];

const cabanesItems = [
  { label: 'Lieu-dit',   value: 'Les Cabanes, Valojoulx' },
  { label: 'Protection', value: 'Inscrit MH (1991)' },
  { label: 'Accès',      value: 'Libre, en plein air' },
];

const otiItems = [
  { label: 'Téléphone', value: '05 53 51 82 60' },
  { label: 'Site',      value: 'https://www.lascaux-dordogne.com' },
  { label: 'Adresse',   value: 'Montignac-Lascaux' },
];

const giteItems = [
  { label: 'Contact',   value: gite.contact },
  { label: 'Téléphone', value: gite.telephone },
  { label: 'Email',     value: gite.email },
];

const gitePoints = [
  { emoji: '✅', texte: "Jusqu'à 14 personnes" },
  { emoji: '♿', texte: 'Accessible PMR' },
  { emoji: '❄️', texte: 'Climatisation' },
  { emoji: '🏡', texte: 'Entièrement neuf' },
  { emoji: '📍', texte: 'Au cœur du bourg' },
  { emoji: '🚗', texte: 'Accès A89' },
];

const patrimoine = [
  { nom: 'Église Saint-Laurent (XIIe s.)',        statut: 'Inscrit MH',  annee: '1974' },
  { nom: 'Gisement de la Combe (Paléolithique)', statut: 'Classé MH',  annee: '1935' },
  { nom: 'Cabanes en pierre sèche (Les Cabanes)', statut: 'Inscrit MH', annee: '1991' },
];

const biodiversite = [
  { emoji: '🌿', titre: 'Les haies et le bocage',       desc: 'Véritables corridors écologiques, ils abritent de nombreux oiseaux et petits mammifères.' },
  { emoji: '🌸', titre: 'Les prairies naturelles',      desc: 'Riches en fleurs sauvages et en insectes pollinisateurs.' },
  { emoji: '💧', titre: 'Les étangs et zones humides',  desc: 'Refuges essentiels pour les amphibiens et les libellules.' },
  { emoji: '🌲', titre: 'Les boisements communaux',     desc: 'Espaces de promenade et habitats pour de nombreuses espèces forestières.' },
];
---

<PageLayout
  title="Découvrir et visiter"
  section="Découvrir"
  description="Patrimoine, randonnées, nature et hébergement à Valojoulx au cœur du Périgord Noir et de la vallée de la Vézère."
  heroImage="/images/hero/decouvrir.jpg"
>
  <div class="container page-content">

    <p class="chapeau">
      Valojoulx et ses environs offrent un concentré exceptionnel du Périgord Noir — art
      préhistorique, architecture romane, nature préservée et gastronomie. À quelques minutes
      de Lascaux, le village constitue une base idéale pour explorer la vallée de la Vézère,
      classée au patrimoine mondial de l'UNESCO et labellisée Grand Site de France.
    </p>

    <!-- ── 1. HISTOIRE & PATRIMOINE ───────────────────── -->
    <section class="section" id="patrimoine" aria-labelledby="patrimoine-titre">
      <h2 class="section-titre" id="patrimoine-titre">Histoire &amp; Patrimoine</h2>

      <!-- Présentation -->
      <h3 class="h3">Présentation de Valojoulx</h3>
      <p class="para">
        Valojoulx est une commune du Périgord Noir, située en rive gauche de la Vézère, à 6 km
        au sud-ouest de Montignac-Lascaux et à 16 km au nord-ouest de Sarlat. Le territoire est
        vallonné et forestier, traversé par plusieurs cours d'eau : la Vézère, la Seignolle et
        le Turançon. Cinq anciens moulins jalonnent le Turançon, visibles sur un chemin balisé.
        L'économie locale repose sur artisanat, petites entreprises, tourisme et agriculture.
      </p>

      <!-- Origines -->
      <h3 class="h3">Origines et histoire</h3>
      <p class="para">
        Le nom Valojoulx viendrait du gaulois <em>avallo</em> (pomme) et du suffixe
        <em>-ialo</em> (clairière), évoquant un val planté de fruitiers.
      </p>

      <div class="histoire-grid">
        <div class="histoire-item">
          <h4 class="h4">Du Paléolithique au Moyen Âge</h4>
          <p class="histoire-item__text">
            Le gisement préhistorique de La Combe montre que la région était habitée dès le
            Paléolithique. La vallée de la Vézère est classée patrimoine mondial de l'UNESCO.
            Au Moyen Âge, l'église paroissiale Saint-Pantaléon a été édifiée au XIIe siècle.
            Le prieuré de Valojoulx est mentionné dès 1321. Pendant la Guerre de Cent Ans,
            les habitants se réfugiaient dans les grottes alentours.
          </p>
        </div>
        <div class="histoire-item">
          <h4 class="h4">De l'époque moderne à aujourd'hui</h4>
          <p class="histoire-item__text">
            Jusqu'au XIXe siècle, Valojoulx était un village rural centré sur l'agriculture et
            le petit artisanat. Les moulins à eau témoignent de cette activité traditionnelle.
            La population a fluctué entre 530 et 580 habitants au XIXe siècle avant de remonter
            au XXIe siècle.
          </p>
        </div>
        <div class="histoire-item">
          <h4 class="h4">Les moulins du Turançon</h4>
          <p class="histoire-item__text">
            Cinq moulins jalonnent le Turançon : Moulin du Treuil, Moulin de Madame, Moulin de
            Lagorce, Moulin de la Mailleraie (ancienne carderie de laine et fromagerie —
            <em>«&nbsp;les véritables camemberts de Valojoulx&nbsp;»</em>),
            Moulin de la Querrerie.
          </p>
        </div>
        <div class="histoire-item">
          <h4 class="h4">Le manganèse au XIXe siècle</h4>
          <p class="histoire-item__text">
            Exploitation du manganèse, activité aujourd'hui disparue qui a marqué le paysage
            industriel de la commune avant de céder la place à l'agriculture et à l'artisanat.
          </p>
        </div>
      </div>

      <!-- Patrimoine architectural -->
      <h3 class="h3">Patrimoine architectural</h3>

      <div class="table-wrapper">
        <table aria-label="Monuments historiques de Valojoulx">
          <thead>
            <tr>
              <th scope="col">Monument</th>
              <th scope="col">Statut</th>
              <th scope="col">Année</th>
            </tr>
          </thead>
          <tbody>
            {patrimoine.map((p, i) => (
              <tr>
                <td class="td-bold">{p.nom}</td>
                <td>
                  <span class={`badge-mh badge-mh--${p.statut === 'Classé MH' ? 'classe' : 'inscrit'}`}>
                    {p.statut}
                  </span>
                </td>
                <td>{p.annee}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Église -->
      <div class="monument">
        <h4 class="h4">Église Saint-Laurent</h4>
        <div class="monument__cols">
          <div>
            <p class="para">
              L'église Saint-Laurent, aussi appelée Saint-Pantaléon, est un édifice roman du
              XIIe siècle inscrit aux Monuments Historiques en 1974. Construite en pierres
              calcaires locales, elle se compose d'une nef à deux travées suivie d'un chœur plus
              étroit. L'extérieur est marqué par de larges contreforts et des modillons sculptés
              romans sur le mur nord. Remaniée à plusieurs reprises : clocher du XVe siècle,
              porte sud du XVIIe siècle, sacristie du XVIIIe siècle, tourelle d'escalier à vis.
              L'arc triomphal en tiers point ouvre le chœur sur la nef. Des fonts baptismaux du
              XIIe siècle enrichissent encore ce joyau du patrimoine religieux périgourdin.
            </p>
          </div>
          <div class="monument__infobox">
            <InfoBox title="Infos visite" items={egliseItems} />
          </div>
        </div>
      </div>

      <!-- Cabanes -->
      <div class="monument">
        <h4 class="h4">Cabanes en pierre sèche</h4>
        <div class="monument__cols">
          <div>
            <p class="para">
              Au lieu-dit Les Cabanes, deux cabanes circulaires en pierre sèche datent du XIXe
              siècle. L'une servait de cuisine, l'autre de chambre. Inscrites aux Monuments
              Historiques en 1991. Construites sans mortier, elles témoignent de l'architecture
              vernaculaire périgourdine.
            </p>
          </div>
          <div class="monument__infobox">
            <InfoBox title="Informations" items={cabanesItems} />
          </div>
        </div>
      </div>

      <!-- Autres sites -->
      <h4 class="h4">Autres sites remarquables</h4>
      <ul class="liste-verte">
        <li>Moulins anciens le long du Turançon</li>
        <li>Manoirs privés : Costepérier, Prandie</li>
        <li>Châteaux privés : Masnègre, Queyrerie (non visitables)</li>
        <li>Château de Losse (commune voisine Thonac, visible depuis la route)</li>
      </ul>
    </section>

    <hr class="section-divider" />

    <!-- ── 2. RANDONNÉES ───────────────────────────────── -->
    <section class="section" id="randonnees" aria-labelledby="randonnees-titre">
      <h2 class="section-titre" id="randonnees-titre">Randonnées et cyclotourisme</h2>

      <!-- Chemin des meuniers -->
      <h3 class="h3">Le Chemin des Meuniers</h3>
      <div class="encadre-info rando-hero">
        <p class="rando-hero__text">
          La Vézère et ses affluents ont accueilli jadis de nombreux moulins. Quelques-uns sont
          encore debout sur la commune et résistent à l'usure du temps.
        </p>
        <p class="rando-hero__text">
          Un parcours balisé utilise la boucle 13 dite du Posadou de l'Office de Tourisme
          Lascaux-Dordogne sur un peu plus de 5 km. Il est marqué de <strong>10 panneaux
          explicatifs</strong> concernant le village et la meunerie.
        </p>
        <p class="rando-hero__text">
          <strong>Les 5 moulins :</strong> Moulin du Treuil · Moulin de Madame · Moulin de
          Lagorce · Moulin de la Mailleraie · Moulin de la Querrerie.
        </p>
        <p class="rando-hero__text">
          On y trouve également un complexe piscicole appartenant à la Fédération
          départementale de Pêche avec deux étangs dans un espace d'une très belle diversité
          en faune et en flore.
        </p>
        <p class="rando-hero__text">
          La valorisation du patrimoine des moulins est portée par l'Association des Moulins du
          Périgord Noir (AMPN), créée fin 2019, regroupant une cinquantaine de membres.
          <a href="https://moulins-en-perigord.fr" target="_blank" rel="noopener noreferrer" class="text-link">
            moulins-en-perigord.fr ↗
          </a>
        </p>
        <div class="badges">
          <span class="badge badge--vert">5 km</span>
          <span class="badge badge--vert">Balisé</span>
          <span class="badge badge--vert">10 panneaux</span>
          <span class="badge badge--vert">Familles</span>
        </div>
      </div>

      <!-- Boucles de découverte -->
      <h3 class="h3">Les boucles de découverte</h3>
      <div class="boucles-grid">
        <div class="boucle-card">
          <div class="boucle-card__header">
            <h4 class="boucle-card__titre">Boucle du Posadou</h4>
            <span class="boucle-card__dist">5 km</span>
          </div>
          <p class="boucle-card__text">
            Balade au paysage changeant, à faire en famille. Cette boucle vous séduira par la
            diversité du paysage et les variations de terrain. Vous pourrez admirer d'anciennes
            bâtisses et des moulins centenaires aux toits de pierres. Vous remarquerez aussi
            l'érosion qu'a pu faire la mer sur les falaises maintenant recouvertes d'une
            splendide forêt.
          </p>
          <a href="https://www.lascaux-dordogne.com" target="_blank" rel="noopener noreferrer" class="text-link">
            Office de Tourisme ↗
          </a>
        </div>
        <div class="boucle-card">
          <div class="boucle-card__header">
            <h4 class="boucle-card__titre">Boucle de la Turançonnaise</h4>
            <span class="boucle-card__dist">9,4 km</span>
          </div>
          <p class="boucle-card__text">
            L'itinéraire vous mène à travers les paysages du Périgord Noir. Vous profiterez de
            magnifiques points de vue sur le Manoir de l'Air (XVIIIe siècle) et celui de
            Costepérier, de la réserve piscicole de Valojoulx avec la forêt pour toile de fond.
          </p>
          <a href="https://www.lascaux-dordogne.com" target="_blank" rel="noopener noreferrer" class="text-link">
            Office de Tourisme ↗
          </a>
        </div>
      </div>

      <!-- Cyclotourisme -->
      <h3 class="h3">Projets cyclotourisme</h3>
      <div class="encadre-warning projet-box">
        <div class="projet-box__header">
          <span class="badge badge--projet">PROJET DU MANDAT</span>
        </div>
        <p class="projet-box__text">
          Deux projets en cours de développement : <strong>Voie douce</strong> et
          <strong>Escale des cyclistes</strong>. Ces aménagements visent à accueillir les
          cyclistes et développer le tourisme doux sur la commune. Plus d'informations à venir.
        </p>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ── 3. NATURE ───────────────────────────────────── -->
    <section class="section" id="nature" aria-labelledby="nature-titre">
      <h2 class="section-titre" id="nature-titre">Nature et environnement</h2>

      <!-- Natura 2000 -->
      <h3 class="h3">Natura 2000</h3>
      <p class="para">
        La Communauté de Communes de la Vallée de l'Homme accorde une place centrale à la
        préservation de la biodiversité. Le dispositif européen Natura 2000 vise à protéger les
        habitats naturels et les espèces menacées tout en conciliant conservation et activités
        humaines.
      </p>
      <p class="para">
        Natura 2000 repose sur deux directives : la directive Oiseaux (1979) et la directive
        Habitats, Faune, Flore (1992). En Dordogne, 21 sites Natura 2000 ont été identifiés,
        dont le site «&nbsp;La Vézère&nbsp;», remarquable pour sa diversité : 17 espèces
        protégées, dont la loutre d'Europe.
      </p>
      <p class="para">
        Le contrat Natura 2000 est une démarche volontaire permettant aux acteurs publics et
        privés de s'engager dans un programme d'actions.
        Pour plus d'informations :
        <a href="tel:+33553597214" class="tel-link">05 53 59 72 14</a>
      </p>

      <!-- Biodiversité -->
      <h3 class="h3">Biodiversité</h3>
      <p class="para">Notre territoire est composé de plusieurs espaces remarquables :</p>

      <ul class="biodiv-grid" role="list">
        {biodiversite.map(b => (
          <li class="biodiv-card">
            <span class="biodiv-card__emoji" aria-hidden="true">{b.emoji}</span>
            <strong class="biodiv-card__titre">{b.titre}</strong>
            <p class="biodiv-card__desc">{b.desc}</p>
          </li>
        ))}
      </ul>

      <div class="encadre-info abc-box">
        <p>
          <strong>Atlas de la Biodiversité Communale (ABC) :</strong> La Communauté de communes
          Vallée de l'Homme a engagé la réalisation d'un ABC, outil de connaissance permettant
          de recenser les milieux naturels et les espèces animales et végétales présentes sur
          le territoire.
        </p>
        <p style="margin-top:0.75rem">
          <strong>Le Printemps de la biodiversité :</strong> Chaque année, la CCVH organise une
          série d'animations ouvertes à tous : sorties nature, ateliers, conférences et actions
          participatives.
          <a href="https://www.cc-valleedelhomme.fr" target="_blank" rel="noopener noreferrer" class="text-link">
            cc-valleedelhomme.fr ↗
          </a>
        </p>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ── 4. OFFICE DE TOURISME ───────────────────────── -->
    <section class="section" id="tourisme" aria-labelledby="tourisme-titre">
      <h2 class="section-titre" id="tourisme-titre">Office de Tourisme</h2>
      <img src="/images/logos/logo-lascaux-dordogne.svg" alt="Office de Tourisme Lascaux-Dordogne Vallée Vézère" class="logo-partenaire" />

      <div class="oti-cols">
        <div>
          <p class="para">
            L'Office de Tourisme de Montignac-Lascaux est votre point de départ idéal pour
            découvrir le Périgord Noir et son patrimoine exceptionnel. Situé au cœur de
            Montignac, il vous accueille pour vous informer sur les sites incontournables, les
            activités culturelles et les circuits de découverte, notamment la célèbre Grotte
            de Lascaux.
          </p>
          <p class="para">
            La vallée de la Vézère rassemble sur une quarantaine de kilomètres quelques-uns des
            plus riches et des plus célèbres sites de la Préhistoire. Le classement au Patrimoine
            Mondial de l'UNESCO reflète la valeur de notre territoire, également labellisé
            <strong>Grand Site de France</strong>.
          </p>
        </div>
        <div>
          <InfoBox title="Office de Tourisme Lascaux-Dordogne Vallée Vézère" items={otiItems} />
        </div>
      </div>

      <h3 class="h3">Grand Site de France</h3>
      <img src="/images/logos/logo-grand-site.png" alt="Grand Site de France - Vallée de la Vézère" class="logo-partenaire" />
      <p class="para">
        La Vallée de la Vézère bénéficie du label <strong>Grand Site de France</strong>, qui
        distingue des paysages remarquables gérés de manière durable, conciliant préservation,
        accueil du public et qualité de vie. Le label est en cours de renouvellement avec un
        nouveau programme d'actions construit avec les acteurs du territoire.
      </p>
      <a
        href="https://www.pole-prehistoire.com"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline"
      >
        Pôle International de la Préhistoire ↗
      </a>
    </section>

    <hr class="section-divider" />

    <!-- ── 5. GÎTE ─────────────────────────────────────── -->
    <section class="section" id="gite" aria-labelledby="gite-titre">
      <h2 class="section-titre" id="gite-titre">La Grange de Valojoulx</h2>

      <div class="encadre-info gite-hero">
        <p class="gite-hero__accroche">Un gîte de charme, au cœur de la préhistoire</p>
        <p class="gite-hero__desc">
          À Valojoulx, aux portes de Lascaux et de la Vallée de la Vézère, la Grange de
          Valojoulx est un gîte de charme accessible PMR qui accueille jusqu'à 14 personnes.
          Idéalement situé, entièrement neuf, il allie de beaux volumes lumineux et confortables,
          conçus pour l'accessibilité de tous. Entièrement climatisé, c'est un havre de paix et
          le point central de toutes les découvertes du territoire.
        </p>
      </div>

      <div class="gite-layout">
        <ul class="gite-points" role="list">
          {gitePoints.map(p => (
            <li class="gite-point">
              <span class="gite-point__emoji" aria-hidden="true">{p.emoji}</span>
              <span>{p.texte}</span>
            </li>
          ))}
        </ul>
        <div>
          <InfoBox title="Réservations" items={giteItems} />
        </div>
      </div>
    </section>

  </div>
</PageLayout>

<style>
  .page-content {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  /* ── CHAPEAU ── */
  .chapeau {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text-light);
    border-left: 4px solid var(--color-accent);
    padding-left: 1.25rem;
    margin-bottom: 3.5rem;
    max-width: 780px;
  }

  /* ── SECTION ── */
  .section {
    margin-bottom: 4rem;
  }

  /* ── TITRES HIÉRARCHIQUES ── */
  .h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .h4 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .para {
    line-height: 1.75;
    color: var(--color-text);
    max-width: 780px;
    margin-bottom: 0.75rem;
  }

  /* ── LIENS ── */
  .text-link {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.88rem;
    margin-left: 0.25rem;
    transition: color 0.15s;
  }

  .text-link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .tel-link {
    color: var(--color-primary-dark);
    font-weight: 600;
    transition: color 0.15s;
  }

  .tel-link:hover { color: var(--color-primary); text-decoration: underline; }

  .btn-outline {
    margin-top: 1rem;
  }

  /* ── HISTOIRE GRID ── */
  .histoire-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .histoire-item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.1rem 1.25rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .histoire-item .h4 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary-pale);
    padding-bottom: 0.4rem;
  }

  .histoire-item__text {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .td-bold { font-weight: 600; color: var(--color-primary-dark); }

  .badge-mh {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.15rem 0.6rem;
    border-radius: 20px;
  }

  .badge-mh--classe {
    background: #fef3c7;
    color: #92400e;
  }

  .badge-mh--inscrit {
    background: var(--color-primary-pale);
    color: var(--color-primary-dark);
  }

  /* ── MONUMENT ── */
  .monument {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .monument__cols {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    align-items: start;
